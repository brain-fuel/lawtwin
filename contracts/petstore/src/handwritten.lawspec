unit lawtwin.petstore.handwritten

-- Written once by `lawtwin import openapi`, and yours from then on: the
-- importer never writes this file again. Each definition answers one
-- operation the importer could not model. Replace its body with what the
-- service does, over the model's State; until then it fails with
-- Unmodelled. An operation added to the document later needs a definition
-- here, and the importer names it. The model's types are written
-- qualified, as model.Pet, so a new import does not break this unit.

import lawtwin.petstore.model as model (ApiError, State)

-- HAND-WRITTEN: GET /pet/findByStatus: Finds Pets by status.
procedure findPetsByStatus (status :: model.PetStatus) (current_ :: State) -> Pair (List model.Pet) State fails with ApiError is
  raise Unmodelled
end procedure

-- HAND-WRITTEN: GET /pet/findByTags: Finds Pets by tags.
procedure findPetsByTags (tags :: List Text) (current_ :: State) -> Pair (List model.Pet) State fails with ApiError is
  raise Unmodelled
end procedure

-- HAND-WRITTEN: POST /pet/{petId}: Updates a pet in the store with form data.
procedure updatePetWithForm (petId :: Int64) (name :: Maybe Text) (status :: Maybe Text) (current_ :: State) -> Pair model.Pet State fails with ApiError is
  raise Unmodelled
end procedure

-- HAND-WRITTEN: POST /pet/{petId}/uploadImage: Uploads an image.
procedure uploadFile (petId :: Int64) (additionalMetadata :: Maybe Text) (body :: Maybe Bytes) (current_ :: State) -> Pair model.ApiResponse State fails with ApiError is
  raise Unmodelled
end procedure

-- HAND-WRITTEN: GET /store/inventory: Returns pet inventories by status.
procedure getInventory (current_ :: State) -> Pair (KeyVal Text Int32) State fails with ApiError is
  raise Unmodelled
end procedure

-- HAND-WRITTEN: POST /user/createWithList: Creates list of users with given input array.
procedure createUsersWithListInput (body :: Maybe (List model.User)) (current_ :: State) -> Pair model.User State fails with ApiError is
  raise Unmodelled
end procedure

-- HAND-WRITTEN: GET /user/login: Logs user into the system.
procedure loginUser (username :: Maybe Text) (password :: Maybe Text) (current_ :: State) -> Pair Text State fails with ApiError is
  raise Unmodelled
end procedure

-- HAND-WRITTEN: GET /user/logout: Logs out current logged in user session.
procedure logoutUser (current_ :: State) -> Pair Unit State fails with ApiError is
  raise Unmodelled
end procedure


end unit
