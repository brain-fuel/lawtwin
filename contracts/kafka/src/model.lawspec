unit lawtwin.kafka.model

-- The reference model of a Kafka cluster: its data, and one checked
-- definition for each request the cluster answers. Each request that
-- changes the cluster takes its state and gives Pair response next, and
-- fails with the KafkaError the broker answers. The reference handler in
-- lawtwin.kafka.contract answers each request by its definition, and the
-- Kafka twin runs the code LawSpec generates from them.
--
-- The model is one broker that leads every partition, with one replica, so
-- the high watermark is the log end offset. Logs are never truncated, so the
-- log start offset is always zero. Groups use the coordinator-assigned
-- protocol of KIP-848: members name themselves, and the coordinator computes
-- the assignment.

-- ---------------------------------------------------------------------------
-- Names and requests
-- ---------------------------------------------------------------------------

type TopicPartition is a record{

  topic :: Text
  partition :: Int32}
end type

type IsolationLevel is one of | ReadUncommitted | ReadCommitted end type

type OffsetSpec is one of | Earliest | Latest end type

-- The error codes of the Kafka protocol that the model returns.
type KafkaError is one of
  | UnknownTopicOrPartition
  | TopicAlreadyExists
  | InvalidTopic
  | InvalidPartitions
  | InvalidRecord
  | InvalidRequest
  | OffsetOutOfRange
  | OutOfOrderSequenceNumber
  | InvalidProducerEpoch
  | ProducerFenced
  | UnknownProducerId
  | InvalidProducerIdMapping
  | InvalidTxnState
  | InvalidGroupId
  | UnknownMemberId
  | IllegalGeneration
  | IllegalState
end type

type Header is a record{

  name :: Text
  content :: Maybe Bytes}
end type

type Record is a record{

  key :: Maybe Bytes
  value :: Maybe Bytes
  headers :: List Header}
end type

-- What an idempotent or transactional producer stamps on a batch.
type ProducerTag is a record{

  producerId :: Int64
  producerEpoch :: Int16
  baseSequence :: Int32}
end type

type ProducerIdAndEpoch is a record{

  producerId :: Int64
  producerEpoch :: Int16}
end type

-- A record as a fetch returns it, with its offset. The field is `entry`
-- because LawSpec's Java target refuses a field named `record`.
type FetchedRecord is a record{

  offset :: Int64
  entry :: Record}
end type

-- A fetch's response. nextOffset is where the next fetch starts: past the
-- last record returned, and past any control or aborted entries skipped.
type FetchResult is a record{

  records :: List FetchedRecord
  nextOffset :: Int64
  highWatermark :: Int64
  lastStableOffset :: Int64}
end type

type OffsetEntry is a record{

  topicPartition :: TopicPartition
  offset :: Int64}
end type

type MemberAssignment is a record{

  memberId :: Text
  assigned :: List TopicPartition}
end type

type GroupView is a record{

  generation :: Int32
  members :: List MemberAssignment}
end type

-- ---------------------------------------------------------------------------
-- The cluster's state
-- ---------------------------------------------------------------------------

-- An entry of a partition's log. A control entry is a transaction marker:
-- it takes an offset, as in Kafka, but no consumer ever receives it.
type LogEntry is one of
  | DataEntry of type record{
    entryOffset :: Int64
    entryRecord :: Record
    writer :: Int64
    transactional :: Bool}
  | ControlEntry of type record{
    markerOffset :: Int64
    markerWriter :: Int64
    commits :: Bool}
end type

-- The aborted-transaction index: the range of one aborted transaction's
-- entries in a partition.
type AbortedTxn is a record{

  abortedWriter :: Int64
  firstOffset :: Int64
  lastOffset :: Int64}
end type

-- What the broker remembers of a recent batch, to recognise a retry.
type BatchMeta is a record{

  batchEpoch :: Int16
  firstSequence :: Int32
  lastSequence :: Int32
  batchOffset :: Int64}
end type

type PartitionLog is a record{

  entries :: List LogEntry
  logEndOffset :: Int64
  openTxns :: KeyVal Int64 Int64
  abortedTxns :: List AbortedTxn
  batches :: KeyVal Int64 (List BatchMeta)}
end type

type PendingOffset is a record{

  pendingGroup :: Text
  pendingEntry :: OffsetEntry}
end type

type TxnState is one of
  | NoTxn
  | Ongoing of type record{
    txnPartitions :: List TopicPartition
    txnOffsets :: List PendingOffset}
end type

type ProducerEntry is a record{

  epoch :: Int16
  transactionalId :: Maybe Text
  txn :: TxnState}
end type

type Group is a record{

  groupGeneration :: Int32
  subscriptions :: KeyVal Text (List Text)
  assignment :: KeyVal Text (List TopicPartition)}
end type

type GroupPartition is a record{

  groupId :: Text
  groupPartition :: TopicPartition}
end type

type BrokerState is a record{

  topics :: KeyVal Text Int32
  logs :: KeyVal TopicPartition PartitionLog
  producers :: KeyVal Int64 ProducerEntry
  transactionalIds :: KeyVal Text Int64
  nextProducerId :: Int64
  groups :: KeyVal Text Group
  committed :: KeyVal GroupPartition Int64}
end type

function emptyBroker (u :: Unit) -> BrokerState is
  BrokerState record{ topics = (prelude.keyValOf []) , logs = (prelude.keyValOf
    []) , producers = (prelude.keyValOf [])
    , transactionalIds = (prelude.keyValOf []) , nextProducerId = 0 , groups =
      (prelude.keyValOf []) , committed = (prelude.keyValOf [])}
end function

function emptyLog (u :: Unit) -> PartitionLog is
  PartitionLog record{ entries = [] , logEndOffset = 0 , openTxns =
      (prelude.keyValOf []) , abortedTxns = [] , batches = (prelude.keyValOf
        [])}
end function

function emptyGroup (u :: Unit) -> Group is
  Group record{ groupGeneration = 0 , subscriptions = (prelude.keyValOf []) ,
    assignment = (prelude.keyValOf [])}
end function

-- ---------------------------------------------------------------------------
-- Lists
-- ---------------------------------------------------------------------------

function min64 (a :: Int64) (b :: Int64) -> Int64 is if a <= b then a else b
  end if end function
function max64 (a :: Int64) (b :: Int64) -> Int64 is if a >= b then a else b
  end if end function

-- The partitions of a topic with n of them, for n at most maxPartitions.
function maxPartitions (u :: Unit) -> Int32 is 1024 end function

function partitionsBelow (n :: Int32) -> List Int32 is prelude.range 0 n
end function

function topicPartitions (topic :: Text) (ps :: List Int32) -> List
  TopicPartition is
  first matching case of ps :
    when Nil then []
    when Cons p rest then Cons (TopicPartition record{ topic = topic , partition
        = p}) (topicPartitions topic rest)
  end case
end function

-- ---------------------------------------------------------------------------
-- Topics
-- ---------------------------------------------------------------------------

-- Kafka's rule for topic names: one to 249 ASCII letters, digits, dots,
-- underscores and dashes, and not "." or "..".
function validTopicName (name :: Text) -> Bool is
  let n = prelude.length name in
    n >= 1 && n <= 249 && name != "." && name != ".." && name matches regex
      "[a-zA-Z0-9._-]+" end let
end function

function partitionCountOf (topic :: Text) (b :: BrokerState) -> Maybe Int32 is
  prelude.lookup topic b.topics
end function

function knownPartition (tp :: TopicPartition) (b :: BrokerState) -> Bool is
  first matching case of partitionCountOf tp.topic b :
    when Nothing then false
    when Just n then tp.partition >= 0 && tp.partition < n
  end case
end function

function logOf (tp :: TopicPartition) (b :: BrokerState) -> PartitionLog is
  first matching case of prelude.lookup tp b.logs :
    when Nothing then emptyLog unitValue
    when Just l then l
  end case
end function

function putLog (tp :: TopicPartition) (l :: PartitionLog) (b :: BrokerState) ->
  BrokerState is
  b with logs = prelude.put tp l b.logs
end function

procedure createTopic (name :: Text) (n :: Int32) (b :: BrokerState) -> Pair
  Unit BrokerState fails with KafkaError is
  if !(validTopicName name) then raise InvalidTopic else
    if n < 1 || n > maxPartitions unitValue then raise InvalidPartitions else
      first matching case of partitionCountOf name b :
        when Just existing then raise TopicAlreadyExists
        when Nothing then Pair unitValue (rebalanceTopic name (b with topics =
            prelude.put name n b.topics))
      end case end if end if
end procedure

procedure createPartitions (name :: Text) (total :: Int32) (b :: BrokerState) ->
  Pair Unit BrokerState fails with KafkaError is
  first matching case of partitionCountOf name b :
    when Nothing then raise UnknownTopicOrPartition
    when Just n then
      if total <= n || total > maxPartitions unitValue then raise
        InvalidPartitions else
        Pair unitValue (rebalanceTopic name (b with topics = prelude.put name
          total b.topics)) end if
  end case
end procedure

function metadata (name :: Text) (b :: BrokerState) -> Pair (Maybe Int32)
  BrokerState is
  Pair (partitionCountOf name b) b
end function

-- ---------------------------------------------------------------------------
-- Logs
-- ---------------------------------------------------------------------------

function lastStableOffset (l :: PartitionLog) -> Int64 is minOf (prelude.values
    l.openTxns) l.logEndOffset end function

function minOf (xs :: List Int64) (m :: Int64) -> Int64 is
  first matching case of xs :
    when Nil then m
    when Cons h t then minOf t (min64 h m)
  end case
end function

function highWatermark (l :: PartitionLog) -> Int64 is l.logEndOffset
end function

-- Appends records at the log end, newest first, and gives the offset after.
function appendRecords (rs :: List Record) (offset :: Int64) (writer :: Int64)
  (transactional :: Bool) (es :: List LogEntry) -> Pair Int64 (List LogEntry) is
  first matching case of rs :
    when Nil then Pair offset es
    when Cons r rest then appendRecords rest (prelude.saturating (offset + 1))
        writer transactional (Cons (DataEntry record{ entryOffset = offset ,
          entryRecord = r , writer = writer , transactional = transactional})
          es)
  end case
end function

function appendBatch (rs :: List Record) (writer :: Int64) (transactional ::
  Bool) (l :: PartitionLog) -> PartitionLog is
  let appended = appendRecords rs l.logEndOffset writer transactional l.entries
    in
    let open = (if transactional then
        (first matching case of prelude.lookup writer l.openTxns :
          when Nothing then prelude.put writer l.logEndOffset l.openTxns
          when Just first then l.openTxns
        end case)
      else l.openTxns end if) in
      l with entries = appended.second, logEndOffset = appended.first, openTxns
        = open end let end let
end function

function rememberBatch (writer :: Int64) (meta :: BatchMeta) (l :: PartitionLog)
  -> PartitionLog is
  let previous = (first matching case of prelude.lookup writer l.batches : when
      Nothing then [] when Just ms then ms end case) in
    l with batches = prelude.put writer (prelude.take 5 (Cons meta previous))
      l.batches end let
end function

-- A retry of a batch the broker already has: the same epoch and sequences.
function findDuplicate (epoch :: Int16) (first :: Int32) (last :: Int32) (ms ::
  List BatchMeta) -> Maybe Int64 is
  first matching case of ms :
    when Nil then Nothing
    when Cons m rest then
      if m.batchEpoch = epoch && m.firstSequence = first && m.lastSequence =
          last then Just m.batchOffset
      else findDuplicate epoch first last rest end if
  end case
end function

-- The sequence the next batch of this producer must start with.
function expectedSequence (epoch :: Int16) (ms :: List BatchMeta) -> Int32 is
  first matching case of ms :
    when Nil then 0
    when Cons m rest then if m.batchEpoch = epoch then prelude.saturating
        (m.lastSequence + 1) else 0 end if
  end case
end function

-- Produce: append a batch to one partition and give its base offset.
procedure produce (tp :: TopicPartition) (tag :: Maybe ProducerTag) (rs :: List
  Record) (b :: BrokerState) -> Pair Int64 BrokerState fails with KafkaError is
  if !(knownPartition tp b) then raise UnknownTopicOrPartition else
    if prelude.isEmpty rs || prelude.length rs > 100000 then raise InvalidRecord
    else
      let l = logOf tp b in
        first matching case of tag :
          when Nothing then Pair (highWatermark l) (putLog tp (appendBatch rs -1
              false l) b)
          when Just t then produceTagged tp t rs l b
        end case end let end if end if
end procedure

procedure produceTagged (tp :: TopicPartition) (t :: ProducerTag) (rs :: List
  Record) (l :: PartitionLog) (b :: BrokerState) -> Pair Int64 BrokerState fails
  with KafkaError is
  first matching case of prelude.lookup t.producerId b.producers :
    when Nothing then raise UnknownProducerId
    when Just entry then
      if t.producerEpoch != entry.epoch then raise InvalidProducerEpoch else
        let transactional = (first matching case of entry.transactionalId : when
            Nothing then false when Just id then true end case) in
          if transactional && !(txnHasPartition tp entry.txn) then raise
            InvalidTxnState else
            let last = prelude.saturating (t.baseSequence + prelude.length rs -
                1) in
              let recent = (first matching case of prelude.lookup t.producerId
                  l.batches : when Nothing then [] when Just ms then ms
                end case)
                in
                first matching case of findDuplicate t.producerEpoch
                  t.baseSequence last recent :
                  when Just offset then Pair offset b
                  when Nothing then
                    if t.baseSequence != expectedSequence t.producerEpoch recent
                      then raise OutOfOrderSequenceNumber else
                      let base = highWatermark l in
                        let l2 = rememberBatch t.producerId (BatchMeta record{
                            batchEpoch = t.producerEpoch , firstSequence =
                            t.baseSequence , lastSequence = last , batchOffset =
                            base}) (appendBatch rs t.producerId transactional
                              l) in
                          Pair base (putLog tp l2 b) end let end let end if
                end case end let end let end if end let end if
  end case
end procedure

function txnHasPartition (tp :: TopicPartition) (txn :: TxnState) -> Bool is
  first matching case of txn :
    when NoTxn then false
    when Ongoing record{ txnPartitions = ps , txnOffsets = os} then ps contains
        tp
  end case
end function

-- Whether an aborted transaction of this writer covers this offset.
function isAborted (writer :: Int64) (offset :: Int64) (aborted :: List
  AbortedTxn) -> Bool is
  first matching case of aborted :
    when Nil then false
    when Cons a rest then (a.abortedWriter = writer && offset >= a.firstOffset
        && offset <= a.lastOffset) || isAborted writer offset rest
  end case
end function

-- The entries a consumer may read from a log, in offset order: data entries
-- from the fetch offset up to the limit, without the aborted ones when it
-- reads committed. The log is newest first, so walking it and consing gives
-- offset order, and the walk stops below the fetch offset.
function readable (es :: List LogEntry) (from :: Int64) (limit :: Int64)
  (committedOnly :: Bool) (aborted :: List AbortedTxn) (acc :: List
  FetchedRecord) -> List FetchedRecord is
  first matching case of es :
    when Nil then acc
    when Cons e rest then
      first matching case of e :
        when DataEntry record{ entryOffset = o , entryRecord = r , writer = w ,
          transactional = tx} then
          if o < from then acc else
            if o >= limit then readable rest from limit committedOnly aborted
              acc else
              if committedOnly && tx && isAborted w o aborted then readable rest
                from limit committedOnly aborted acc else
                readable rest from limit committedOnly aborted (Cons
                  (FetchedRecord record{ offset = o , entry = r}) acc) end if
            end if end if
        when ControlEntry record{ markerOffset = o , markerWriter = w , commits
          = c} then
          if o < from then acc else readable rest from limit committedOnly
            aborted acc end if
      end case
  end case
end function

function lastOffsetOf (rs :: List FetchedRecord) (fallbackOffset :: Int64) ->
  Int64 is
  first matching case of rs :
    when Nil then fallbackOffset
    when Cons h t then lastOffsetOf t h.offset
  end case
end function

-- Where the next fetch starts: past the last record taken, when the fetch
-- stopped at maxRecords; fallbackOffset at the limit, past every entry skipped.
function nextFetchOffset (from :: Int64) (limit :: Int64) (taken :: List
  FetchedRecord) (all :: List FetchedRecord) -> Int64 is
  if prelude.length taken < prelude.length all then
    (first matching case of taken :
      when Nil then from
      when Cons h t then prelude.saturating (lastOffsetOf taken from + 1)
    end case)
  else max64 from limit end if
end function

procedure fetch (tp :: TopicPartition) (from :: Int64) (maxRecords :: Int32)
  (isolation :: IsolationLevel) (b :: BrokerState) -> Pair FetchResult
  BrokerState fails with KafkaError is
  if !(knownPartition tp b) then raise UnknownTopicOrPartition else
    let l = logOf tp b in
      let hw = highWatermark l in
        let lso = lastStableOffset l in
          if from < 0 || from > hw then raise OffsetOutOfRange else
            let committedOnly = (first matching case of isolation : when
                ReadUncommitted then false when ReadCommitted then true
              end case)
              in
              let limit = (if committedOnly then lso else hw end if) in
                let all = readable l.entries from limit committedOnly
                    l.abortedTxns [] in
                  let taken = prelude.take maxRecords all in
                    Pair (FetchResult record{ records = taken , nextOffset =
                        (nextFetchOffset from limit taken all) , highWatermark =
                        hw , lastStableOffset = lso}) b end let end let end let
            end let end if end let end let end let end if
end procedure

procedure listOffsets (tp :: TopicPartition) (spec :: OffsetSpec) (isolation ::
  IsolationLevel) (b :: BrokerState) -> Pair Int64 BrokerState fails with
  KafkaError is
  if !(knownPartition tp b) then raise UnknownTopicOrPartition else
    let l = logOf tp b in
      first matching case of spec :
        when Earliest then Pair 0 b
        when Latest then
          first matching case of isolation :
            when ReadUncommitted then Pair (highWatermark l) b
            when ReadCommitted then Pair (lastStableOffset l) b
          end case
      end case end let end if
end procedure

-- ---------------------------------------------------------------------------
-- Producer ids and transactions
-- ---------------------------------------------------------------------------

function newProducer (txid :: Maybe Text) (b :: BrokerState) -> Pair
  ProducerIdAndEpoch BrokerState is
  let pid = b.nextProducerId in
    let withEntry = b with producers = prelude.put pid (ProducerEntry record{
        epoch = 0 , transactionalId = txid , txn = NoTxn}) b.producers,
        nextProducerId = prelude.saturating (pid + 1) in
      let mapped = (first matching case of txid :
          when Nothing then withEntry
          when Just id then withEntry with transactionalIds = prelude.put id pid
              withEntry.transactionalIds
        end case) in
        Pair (ProducerIdAndEpoch record{ producerId = pid , producerEpoch = 0})
          mapped end let end let end let
end function

-- InitProducerId. A transactional id that is already known keeps its
-- producer id and gets the next epoch, which fences every older instance;
-- its open transaction is aborted.
procedure initProducerId (txid :: Maybe Text) (b :: BrokerState) -> Pair
  ProducerIdAndEpoch BrokerState fails with KafkaError is
  first matching case of txid :
    when Nothing then newProducer Nothing b
    when Just id then
      if id = "" then raise InvalidRequest else
        first matching case of prelude.lookup id b.transactionalIds :
          when Nothing then newProducer txid b
          when Just pid then
            first matching case of prelude.lookup pid b.producers :
              when Nothing then newProducer txid b
              when Just entry then
                let cleared = finishTxn pid false entry.txn b in
                  if entry.epoch < Int16.max then
                    let bumped = prelude.saturating (entry.epoch + 1) in
                      Pair (ProducerIdAndEpoch record{ producerId = pid ,
                        producerEpoch = bumped}) (putProducer pid (entry with
                          epoch = bumped, txn = NoTxn) cleared) end let
                  else newProducer txid cleared end if end let
            end case
        end case end if
  end case
end procedure

-- The checks every transactional request makes: the transactional id maps
-- to this producer id, and the epoch is current. An older epoch is a fenced
-- zombie.
procedure checkTxnProducer (txid :: Text) (pid :: Int64) (epoch :: Int16) (b ::
  BrokerState) -> ProducerEntry fails with KafkaError is
  first matching case of prelude.lookup txid b.transactionalIds :
    when Nothing then raise InvalidProducerIdMapping
    when Just mapped then
      if mapped != pid then raise InvalidProducerIdMapping else
        first matching case of prelude.lookup pid b.producers :
          when Nothing then raise InvalidProducerIdMapping
          when Just entry then
            if epoch < entry.epoch then raise ProducerFenced else
              if epoch > entry.epoch then raise InvalidProducerEpoch else entry
              end if end if
        end case end if
  end case
end procedure

function allKnown (tps :: List TopicPartition) (b :: BrokerState) -> Bool is
  first matching case of tps :
    when Nil then true
    when Cons h t then knownPartition h b && allKnown t b
  end case
end function

function unionPartitions (xs :: List TopicPartition) (ys :: List TopicPartition)
  -> List TopicPartition is
  first matching case of xs :
    when Nil then ys
    when Cons h t then if ys contains h then unionPartitions t ys else
        unionPartitions t (Cons h ys) end if
  end case
end function

function putProducer (pid :: Int64) (entry :: ProducerEntry) (b :: BrokerState)
  -> BrokerState is
  b with producers = prelude.put pid entry b.producers
end function

procedure addPartitionsToTxn (txid :: Text) (pid :: Int64) (epoch :: Int16) (tps
  :: List TopicPartition) (b :: BrokerState) -> Pair Unit BrokerState fails with
  KafkaError is
  let entry = checkTxnProducer txid pid epoch b in
    if !(allKnown tps b) then raise UnknownTopicOrPartition else
      let next = (first matching case of entry.txn :
          when NoTxn then Ongoing record{ txnPartitions = (unionPartitions tps
              []) , txnOffsets = []}
          when Ongoing record{ txnPartitions = ps , txnOffsets = os} then
            Ongoing record{ txnPartitions = (unionPartitions tps ps) ,
              txnOffsets = os}
        end case) in
        Pair unitValue (putProducer pid (entry with txn = next) b) end let
    end if end let
end procedure

function pendingFor (group :: Text) (offsets :: List OffsetEntry) (acc :: List
  PendingOffset) -> List PendingOffset is
  first matching case of offsets :
    when Nil then acc
    when Cons o rest then pendingFor group rest (Cons (PendingOffset record{
        pendingGroup = group , pendingEntry = o}) acc)
  end case
end function

-- AddOffsetsToTxn and TxnOffsetCommit in one: the offsets are committed only
-- if the transaction commits.
procedure txnOffsetCommit (txid :: Text) (pid :: Int64) (epoch :: Int16) (group
  :: Text) (offsets :: List OffsetEntry) (b :: BrokerState) -> Pair Unit
  BrokerState fails with KafkaError is
  if group = "" then raise InvalidGroupId else
    let entry = checkTxnProducer txid pid epoch b in
      let next = (first matching case of entry.txn :
          when NoTxn then Ongoing record{ txnPartitions = [] , txnOffsets =
              (pendingFor group offsets [])}
          when Ongoing record{ txnPartitions = ps , txnOffsets = os} then
            Ongoing record{ txnPartitions = ps , txnOffsets = (pendingFor group
              offsets os)}
        end case) in
        Pair unitValue (putProducer pid (entry with txn = next) b) end let
    end let end if
end procedure

-- Writes a commit or abort marker to one partition of a transaction.
function writeMarker (pid :: Int64) (commit :: Bool) (l :: PartitionLog) ->
  PartitionLog is
  let aborted = (if commit then l.abortedTxns else
      (first matching case of prelude.lookup pid l.openTxns :
        when Nothing then l.abortedTxns
        when Just first then Cons (AbortedTxn record{ abortedWriter = pid ,
            firstOffset = first , lastOffset = l.logEndOffset}) l.abortedTxns
      end case) end if) in
    l with entries = Cons (ControlEntry record{ markerOffset = l.logEndOffset ,
      markerWriter = pid , commits = commit}) l.entries,
      logEndOffset = prelude.saturating (l.logEndOffset + 1),
      openTxns = prelude.delete pid l.openTxns,
      abortedTxns = aborted end let
end function

function writeMarkers (pid :: Int64) (commit :: Bool) (tps :: List
  TopicPartition) (b :: BrokerState) -> BrokerState is
  first matching case of tps :
    when Nil then b
    when Cons tp rest then writeMarkers pid commit rest (putLog tp (writeMarker
        pid commit (logOf tp b)) b)
  end case
end function

function applyOffsets (os :: List PendingOffset) (b :: BrokerState) ->
  BrokerState is
  first matching case of os :
    when Nil then b
    when Cons o rest then
      applyOffsets rest (b with committed = prelude.put (GroupPartition record{
        groupId = o.pendingGroup , groupPartition =
          o.pendingEntry.topicPartition}) o.pendingEntry.offset b.committed)
  end case
end function

-- Ends a transaction: markers in every partition it touched and, on
-- commit, its offsets. The producer's own entry is left to the caller.
function finishTxn (pid :: Int64) (commit :: Bool) (txn :: TxnState) (b ::
  BrokerState) -> BrokerState is
  first matching case of txn :
    when NoTxn then b
    when Ongoing record{ txnPartitions = ps , txnOffsets = os} then
      let marked = writeMarkers pid commit ps b in
        if commit then applyOffsets (reversePending os []) marked else marked
        end if end let
  end case
end function

function reversePending (os :: List PendingOffset) (acc :: List PendingOffset)
  -> List PendingOffset is
  first matching case of os :
    when Nil then acc
    when Cons h t then reversePending t (Cons h acc)
  end case
end function

procedure endTxn (txid :: Text) (pid :: Int64) (epoch :: Int16) (commit :: Bool)
  (b :: BrokerState) -> Pair Unit BrokerState fails with KafkaError is
  let entry = checkTxnProducer txid pid epoch b in
    first matching case of entry.txn :
      when NoTxn then raise InvalidTxnState
      when Ongoing record{ txnPartitions = ps , txnOffsets = os} then
        Pair unitValue (putProducer pid (entry with txn = NoTxn) (finishTxn pid
          commit entry.txn b))
    end case end let
end procedure

-- ---------------------------------------------------------------------------
-- Groups
-- ---------------------------------------------------------------------------

function groupOf (g :: Text) (b :: BrokerState) -> Group is
  first matching case of prelude.lookup g b.groups :
    when Nothing then emptyGroup unitValue
    when Just group then group
  end case
end function

function putGroup (g :: Text) (group :: Group) (b :: BrokerState) -> BrokerState
  is
  b with groups = prelude.put g group b.groups
end function

-- The members, in member id order, that subscribe to a topic.
function subscribersOf (topic :: Text) (subs :: List (Entry Text (List Text)))
  -> List Text is
  first matching case of subs :
    when Nil then []
    when Cons e rest then
      if e.value contains topic then Cons e.key (subscribersOf topic rest) else
        subscribersOf topic rest end if
  end case
end function

function assignTo (member :: Text) (tp :: TopicPartition) (a :: KeyVal Text
  (List TopicPartition)) -> KeyVal Text (List TopicPartition) is
  first matching case of prelude.lookup member a :
    when Nothing then prelude.put member [tp] a
    when Just tps then prelude.put member (tps ++ [tp]) a
  end case
end function

-- The partitions of a topic go to its subscribers in turn, in member id
-- order, starting again from the first when every subscriber has one:
-- every partition has exactly one owner. `waiting` is the subscribers still
-- to get one in this round.
function assignPartitions (topic :: Text) (ps :: List Int32) (owners :: List
  Text) (waiting :: List Text) (a :: KeyVal Text (List TopicPartition)) ->
  KeyVal Text (List TopicPartition) is
  first matching case of ps :
    when Nil then a
    when Cons p rest then
      first matching case of waiting :
        when Cons owner later then assignPartitions topic rest owners later
            (assignTo owner (TopicPartition record{ topic = topic , partition =
                p}) a)
        when Nil then
          first matching case of owners :
            when Nil then a
            when Cons owner later then assignPartitions topic rest owners later
                (assignTo owner (TopicPartition record{ topic = topic ,
                  partition
                  = p}) a)
          end case
      end case
  end case
end function

function subscribedTopics (subs :: List (Entry Text (List Text))) (acc ::
  SortedSet Text) -> SortedSet Text is
  first matching case of subs :
    when Nil then acc
    when Cons e rest then subscribedTopics rest (prelude.sortedSetUnion acc
        (prelude.sortedSetOf e.value))
  end case
end function

function assignTopics (topics :: List Text) (subs :: List (Entry Text (List
  Text))) (b :: BrokerState) (a :: KeyVal Text (List TopicPartition)) -> KeyVal
  Text (List TopicPartition) is
  first matching case of topics :
    when Nil then a
    when Cons topic rest then
      first matching case of partitionCountOf topic b :
        when Nothing then assignTopics rest subs b a
        when Just n then assignTopics rest subs b (let owners = subscribersOf
            topic subs in assignPartitions topic (partitionsBelow n) owners
              owners
              a end let)
      end case
  end case
end function

function emptyAssignments (members :: List Text) (a :: KeyVal Text (List
  TopicPartition)) -> KeyVal Text (List TopicPartition) is
  first matching case of members :
    when Nil then a
    when Cons m rest then emptyAssignments rest (prelude.put m [] a)
  end case
end function

-- The coordinator's assignment for the group's members and subscriptions.
function computeAssignment (subscriptions :: KeyVal Text (List Text)) (b ::
  BrokerState) -> KeyVal Text (List TopicPartition) is
  let subs = prelude.entries subscriptions in
    assignTopics (prelude.toList (subscribedTopics subs (prelude.sortedSetOf
      []))) subs b
      (emptyAssignments (prelude.keys subscriptions) (prelude.keyValOf []))
  end let
end function

-- A new generation of the group, with a fresh assignment.
function rebalance (group :: Group) (b :: BrokerState) -> Group is
  group with groupGeneration = prelude.saturating (group.groupGeneration + 1),
    assignment = computeAssignment group.subscriptions b
end function

function subscribesTo (topic :: Text) (group :: Group) -> Bool is
  !(prelude.isEmpty (subscribersOf topic (prelude.entries group.subscriptions)))
end function

function rebalanceGroups (topic :: Text) (gs :: List (Entry Text Group)) (b ::
  BrokerState) (acc :: KeyVal Text Group) -> KeyVal Text Group is
  first matching case of gs :
    when Nil then acc
    when Cons e rest then
      rebalanceGroups topic rest b (prelude.put e.key (if subscribesTo topic
        e.value then rebalance e.value b else e.value end if) acc)
  end case
end function

-- A topic's partitions changed: every group that subscribes to it
-- rebalances.
function rebalanceTopic (topic :: Text) (b :: BrokerState) -> BrokerState is
  b with groups = rebalanceGroups topic (prelude.entries b.groups) b b.groups
end function

-- JoinGroup. A new member, or a member whose subscription changed, starts a
-- new generation; a member that rejoins unchanged learns the current one.
procedure joinGroup (g :: Text) (member :: Text) (topics :: List Text) (b ::
  BrokerState) -> Pair Int32 BrokerState fails with KafkaError is
  if g = "" then raise InvalidGroupId else
    if member = "" then raise UnknownMemberId else
      let group = groupOf g b in
        let wanted = prelude.toList (prelude.sortedSetOf topics) in
          first matching case of prelude.lookup member group.subscriptions :
            when Just existing then
              if existing = wanted then Pair group.groupGeneration b else
                let next = rebalance (group with subscriptions = prelude.put
                    member wanted group.subscriptions) b in
                  Pair next.groupGeneration (putGroup g next b) end let end if
            when Nothing then
              let next = rebalance (group with subscriptions = prelude.put
                  member wanted group.subscriptions) b in
                Pair next.groupGeneration (putGroup g next b) end let
          end case end let end let end if end if
end procedure

-- The checks of SyncGroup, Heartbeat and OffsetCommit: the member belongs to
-- the group, at its current generation.
procedure checkMember (g :: Text) (member :: Text) (generation :: Int32) (b ::
  BrokerState) -> Group fails with KafkaError is
  if g = "" then raise InvalidGroupId else
    let group = groupOf g b in
      first matching case of prelude.lookup member group.subscriptions :
        when Nothing then raise UnknownMemberId
        when Just topics then if generation != group.groupGeneration then raise
            IllegalGeneration else group end if
      end case end let end if
end procedure

procedure syncGroup (g :: Text) (member :: Text) (generation :: Int32) (b ::
  BrokerState) -> Pair (List TopicPartition) BrokerState fails with KafkaError
  is
  let group = checkMember g member generation b in
    first matching case of prelude.lookup member group.assignment :
      when Nothing then Pair [] b
      when Just tps then Pair tps b
    end case end let
end procedure

procedure heartbeat (g :: Text) (member :: Text) (generation :: Int32) (b ::
  BrokerState) -> Pair Unit BrokerState fails with KafkaError is
  let group = checkMember g member generation b in Pair unitValue b end let
end procedure

procedure leaveGroup (g :: Text) (member :: Text) (b :: BrokerState) -> Pair
  Unit BrokerState fails with KafkaError is
  let group = groupOf g b in
    first matching case of prelude.lookup member group.subscriptions :
      when Nothing then raise UnknownMemberId
      when Just topics then
        Pair unitValue (putGroup g (rebalance (group with subscriptions =
          prelude.delete member group.subscriptions) b) b)
    end case end let
end procedure

function memberViews (a :: List (Entry Text (List TopicPartition))) -> List
  MemberAssignment is
  first matching case of a :
    when Nil then []
    when Cons e rest then Cons (MemberAssignment record{ memberId = e.key ,
        assigned = e.value}) (memberViews rest)
  end case
end function

function describeGroup (g :: Text) (b :: BrokerState) -> Pair GroupView
  BrokerState is
  let group = groupOf g b in Pair (GroupView record{ generation =
      group.groupGeneration , members = (memberViews (prelude.entries
        group.assignment))}) b end let
end function

function commitAll (g :: Text) (offsets :: List OffsetEntry) (b :: BrokerState)
  -> BrokerState is
  first matching case of offsets :
    when Nil then b
    when Cons o rest then commitAll g rest (b with committed = prelude.put
        (GroupPartition record{ groupId = g , groupPartition =
            o.topicPartition})
        o.offset b.committed)
  end case
end function

function offsetPartitions (offsets :: List OffsetEntry) -> List TopicPartition
  is
  first matching case of offsets :
    when Nil then []
    when Cons o rest then Cons o.topicPartition (offsetPartitions rest)
  end case
end function

-- OffsetCommit. A member commits at its current generation. A consumer
-- outside any group commits with member "" and generation -1, which only an
-- empty group accepts.
procedure offsetCommit (g :: Text) (member :: Text) (generation :: Int32)
  (offsets :: List OffsetEntry) (b :: BrokerState) -> Pair Unit BrokerState
  fails with KafkaError is
  if g = "" then raise InvalidGroupId else
    if !(allKnown (offsetPartitions offsets) b) then raise
      UnknownTopicOrPartition else
      let group = groupOf g b in
        if member = "" && generation = -1 then
          (if prelude.isEmpty group.subscriptions then Pair unitValue (commitAll
            g offsets b) else raise IllegalGeneration end if)
        else
          let checked = checkMember g member generation b in Pair unitValue
              (commitAll g offsets b) end let end if end let end if end if
end procedure

function offsetFetch (g :: Text) (tp :: TopicPartition) (b :: BrokerState) ->
  Pair (Maybe Int64) BrokerState is
  Pair (prelude.lookup (GroupPartition record{ groupId = g , groupPartition =
      tp}) b.committed) b
end function

end unit
