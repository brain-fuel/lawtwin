unit lawtwin.kafka.model

-- The reference model of a Kafka cluster: its data, and one checked
-- definition for each request the cluster answers. Each request that
-- changes the cluster takes its state and gives Pair response next, and
-- fails with the KafkaError the broker answers. The reference handler in
-- lawtwin.kafka.contract answers each request by its definition, and the
-- Kafka twin runs the code LawSpec generates from them.
--
-- The model is one broker that leads every partition, with one replica, so
-- the high watermark is the log end offset. Logs are never truncated, so the
-- log start offset is always zero. Groups use the coordinator-assigned
-- protocol of KIP-848: members name themselves, and the coordinator computes
-- the assignment.

-- ---------------------------------------------------------------------------
-- Names and requests
-- ---------------------------------------------------------------------------

type TopicPartition is
  TopicPartition
    topic :: Text
    partition :: Int32
end

type IsolationLevel is | ReadUncommitted | ReadCommitted end

type OffsetSpec is | Earliest | Latest end

-- The error codes of the Kafka protocol that the model returns.
type KafkaError is
  | UnknownTopicOrPartition
  | TopicAlreadyExists
  | InvalidTopic
  | InvalidPartitions
  | InvalidRecord
  | InvalidRequest
  | OffsetOutOfRange
  | OutOfOrderSequenceNumber
  | InvalidProducerEpoch
  | ProducerFenced
  | UnknownProducerId
  | InvalidProducerIdMapping
  | InvalidTxnState
  | InvalidGroupId
  | UnknownMemberId
  | IllegalGeneration
  | IllegalState
end

type Header is
  Header
    name :: Text
    content :: Maybe Bytes
end

type Record is
  Record
    key :: Maybe Bytes
    value :: Maybe Bytes
    headers :: List Header
end

-- What an idempotent or transactional producer stamps on a batch.
type ProducerTag is
  ProducerTag
    producerId :: Int64
    producerEpoch :: Int16
    baseSequence :: Int32
end

type ProducerIdAndEpoch is
  ProducerIdAndEpoch
    producerId :: Int64
    producerEpoch :: Int16
end

-- A record as a fetch returns it, with its offset. The field is `entry`
-- because LawSpec's Java target refuses a field named `record`.
type FetchedRecord is
  FetchedRecord
    offset :: Int64
    entry :: Record
end

-- A fetch's response. nextOffset is where the next fetch starts: past the
-- last record returned, and past any control or aborted entries skipped.
type FetchResult is
  FetchResult
    records :: List FetchedRecord
    nextOffset :: Int64
    highWatermark :: Int64
    lastStableOffset :: Int64
end

type OffsetEntry is
  OffsetEntry
    topicPartition :: TopicPartition
    offset :: Int64
end

type MemberAssignment is
  MemberAssignment
    memberId :: Text
    assigned :: List TopicPartition
end

type GroupView is
  GroupView
    generation :: Int32
    members :: List MemberAssignment
end

-- ---------------------------------------------------------------------------
-- The cluster's state
-- ---------------------------------------------------------------------------

-- An entry of a partition's log. A control entry is a transaction marker:
-- it takes an offset, as in Kafka, but no consumer ever receives it.
type LogEntry is
  | DataEntry
      entryOffset :: Int64
      entryRecord :: Record
      writer :: Int64
      transactional :: Bool
  | ControlEntry
      markerOffset :: Int64
      markerWriter :: Int64
      commits :: Bool
end

-- The aborted-transaction index: the range of one aborted transaction's
-- entries in a partition.
type AbortedTxn is
  AbortedTxn
    abortedWriter :: Int64
    firstOffset :: Int64
    lastOffset :: Int64
end

-- What the broker remembers of a recent batch, to recognise a retry.
type BatchMeta is
  BatchMeta
    batchEpoch :: Int16
    firstSequence :: Int32
    lastSequence :: Int32
    batchOffset :: Int64
end

type PartitionLog is
  PartitionLog
    entries :: List LogEntry
    logEndOffset :: Int64
    openTxns :: KeyVal Int64 Int64
    abortedTxns :: List AbortedTxn
    batches :: KeyVal Int64 (List BatchMeta)
end

type PendingOffset is
  PendingOffset
    pendingGroup :: Text
    pendingEntry :: OffsetEntry
end

type TxnState is
  | NoTxn
  | Ongoing
      txnPartitions :: List TopicPartition
      txnOffsets :: List PendingOffset
end

type ProducerEntry is
  ProducerEntry
    epoch :: Int16
    transactionalId :: Maybe Text
    txn :: TxnState
end

type Group is
  Group
    groupGeneration :: Int32
    subscriptions :: KeyVal Text (List Text)
    assignment :: KeyVal Text (List TopicPartition)
end

type GroupPartition is
  GroupPartition
    groupId :: Text
    groupPartition :: TopicPartition
end

type BrokerState is
  BrokerState
    topics :: KeyVal Text Int32
    logs :: KeyVal TopicPartition PartitionLog
    producers :: KeyVal Int64 ProducerEntry
    transactionalIds :: KeyVal Text Int64
    nextProducerId :: Int64
    groups :: KeyVal Text Group
    committed :: KeyVal GroupPartition Int64
end

definition emptyBroker (u :: Unit) :: BrokerState is
  BrokerState (prelude.keyValOf []) (prelude.keyValOf []) (prelude.keyValOf [])
    (prelude.keyValOf []) 0 (prelude.keyValOf []) (prelude.keyValOf [])
end

definition emptyLog (u :: Unit) :: PartitionLog is
  PartitionLog [] 0 (prelude.keyValOf []) [] (prelude.keyValOf [])
end

definition emptyGroup (u :: Unit) :: Group is
  Group 0 (prelude.keyValOf []) (prelude.keyValOf [])
end

-- ---------------------------------------------------------------------------
-- Lists
-- ---------------------------------------------------------------------------

definition min64 (a :: Int64) (b :: Int64) :: Int64 is if a <= b then a else b end
definition max64 (a :: Int64) (b :: Int64) :: Int64 is if a >= b then a else b end

-- The partitions of a topic with n of them, for n at most maxPartitions.
definition maxPartitions (u :: Unit) :: Int32 is 1024 end

definition partitionsBelow (n :: Int32) :: List Int32 is prelude.range 0 n end

definition topicPartitions (topic :: Text) (ps :: List Int32) :: List TopicPartition is
  match ps with
  | Nil -> []
  | Cons p rest -> Cons (TopicPartition topic p) (topicPartitions topic rest)
  end
end

-- ---------------------------------------------------------------------------
-- Topics
-- ---------------------------------------------------------------------------

-- Kafka's rule for topic names: one to 249 ASCII letters, digits, dots,
-- underscores and dashes, and not "." or "..".
definition validTopicName (name :: Text) :: Bool is
  let n = prelude.length name in
  n >= 1 && n <= 249 && name != "." && name != ".." && name matches regex "[a-zA-Z0-9._-]+"
end

definition partitionCountOf (topic :: Text) (b :: BrokerState) :: Maybe Int32 is
  prelude.lookup topic b.topics
end

definition knownPartition (tp :: TopicPartition) (b :: BrokerState) :: Bool is
  match partitionCountOf tp.topic b with
  | Nothing -> false
  | Just n -> tp.partition >= 0 && tp.partition < n
  end
end

definition logOf (tp :: TopicPartition) (b :: BrokerState) :: PartitionLog is
  match prelude.lookup tp b.logs with
  | Nothing -> emptyLog unitValue
  | Just l -> l
  end
end

definition putLog (tp :: TopicPartition) (l :: PartitionLog) (b :: BrokerState) :: BrokerState is
  b with logs = prelude.put tp l b.logs
end

definition createTopic (name :: Text) (n :: Int32) (b :: BrokerState) :: Pair Unit BrokerState fails with KafkaError is
  if !(validTopicName name) then raise InvalidTopic else
  if n < 1 || n > maxPartitions unitValue then raise InvalidPartitions else
  match partitionCountOf name b with
  | Just existing -> raise TopicAlreadyExists
  | Nothing -> Pair unitValue (rebalanceTopic name (b with topics = prelude.put name n b.topics))
  end
end

definition createPartitions (name :: Text) (total :: Int32) (b :: BrokerState) :: Pair Unit BrokerState fails with KafkaError is
  match partitionCountOf name b with
  | Nothing -> raise UnknownTopicOrPartition
  | Just n ->
      if total <= n || total > maxPartitions unitValue then raise InvalidPartitions else
        Pair unitValue (rebalanceTopic name (b with topics = prelude.put name total b.topics))
  end
end

definition metadata (name :: Text) (b :: BrokerState) :: Pair (Maybe Int32) BrokerState is
  Pair (partitionCountOf name b) b
end

-- ---------------------------------------------------------------------------
-- Logs
-- ---------------------------------------------------------------------------

definition lastStableOffset (l :: PartitionLog) :: Int64 is minOf (prelude.values l.openTxns) l.logEndOffset end

definition minOf (xs :: List Int64) (m :: Int64) :: Int64 is
  match xs with
  | Nil -> m
  | Cons h t -> minOf t (min64 h m)
  end
end

definition highWatermark (l :: PartitionLog) :: Int64 is l.logEndOffset end

-- Appends records at the log end, newest first, and gives the offset after.
definition appendRecords (rs :: List Record) (offset :: Int64) (writer :: Int64) (transactional :: Bool) (es :: List LogEntry) :: Pair Int64 (List LogEntry) is
  match rs with
  | Nil -> Pair offset es
  | Cons r rest -> appendRecords rest (prelude.saturating (offset + 1)) writer transactional (Cons (DataEntry offset r writer transactional) es)
  end
end

definition appendBatch (rs :: List Record) (writer :: Int64) (transactional :: Bool) (l :: PartitionLog) :: PartitionLog is
  let appended = appendRecords rs l.logEndOffset writer transactional l.entries in
  let open = (if transactional then
                (match prelude.lookup writer l.openTxns with
                 | Nothing -> prelude.put writer l.logEndOffset l.openTxns
                 | Just first -> l.openTxns
                 end)
              else l.openTxns) in
  l with entries = appended.second, logEndOffset = appended.first, openTxns = open
end

definition rememberBatch (writer :: Int64) (meta :: BatchMeta) (l :: PartitionLog) :: PartitionLog is
  let previous = (match prelude.lookup writer l.batches with | Nothing -> [] | Just ms -> ms end) in
  l with batches = prelude.put writer (prelude.take 5 (Cons meta previous)) l.batches
end

-- A retry of a batch the broker already has: the same epoch and sequences.
definition findDuplicate (epoch :: Int16) (first :: Int32) (last :: Int32) (ms :: List BatchMeta) :: Maybe Int64 is
  match ms with
  | Nil -> Nothing
  | Cons m rest ->
      if m.batchEpoch == epoch && m.firstSequence == first && m.lastSequence == last then Just m.batchOffset
      else findDuplicate epoch first last rest
  end
end

-- The sequence the next batch of this producer must start with.
definition expectedSequence (epoch :: Int16) (ms :: List BatchMeta) :: Int32 is
  match ms with
  | Nil -> 0
  | Cons m rest -> if m.batchEpoch == epoch then prelude.saturating (m.lastSequence + 1) else 0
  end
end

-- Produce: append a batch to one partition and give its base offset.
definition produce (tp :: TopicPartition) (tag :: Maybe ProducerTag) (rs :: List Record) (b :: BrokerState) :: Pair Int64 BrokerState fails with KafkaError is
  if !(knownPartition tp b) then raise UnknownTopicOrPartition else
  if prelude.isEmpty rs || prelude.length rs > 100000 then raise InvalidRecord else
  let l = logOf tp b in
  match tag with
  | Nothing -> Pair (highWatermark l) (putLog tp (appendBatch rs -1 false l) b)
  | Just t -> produceTagged tp t rs l b
  end
end

definition produceTagged (tp :: TopicPartition) (t :: ProducerTag) (rs :: List Record) (l :: PartitionLog) (b :: BrokerState) :: Pair Int64 BrokerState fails with KafkaError is
  match prelude.lookup t.producerId b.producers with
  | Nothing -> raise UnknownProducerId
  | Just entry ->
      if t.producerEpoch != entry.epoch then raise InvalidProducerEpoch else
      let transactional = (match entry.transactionalId with | Nothing -> false | Just id -> true end) in
      if transactional && !(txnHasPartition tp entry.txn) then raise InvalidTxnState else
      let last = prelude.saturating (t.baseSequence + prelude.length rs - 1) in
      let recent = (match prelude.lookup t.producerId l.batches with | Nothing -> [] | Just ms -> ms end) in
      match findDuplicate t.producerEpoch t.baseSequence last recent with
      | Just offset -> Pair offset b
      | Nothing ->
          if t.baseSequence != expectedSequence t.producerEpoch recent then raise OutOfOrderSequenceNumber else
            let base = highWatermark l in
            let l2 = rememberBatch t.producerId (BatchMeta t.producerEpoch t.baseSequence last base) (appendBatch rs t.producerId transactional l) in
            Pair base (putLog tp l2 b)
      end
  end
end

definition txnHasPartition (tp :: TopicPartition) (txn :: TxnState) :: Bool is
  match txn with
  | NoTxn -> false
  | Ongoing ps os -> ps contains tp
  end
end

-- Whether an aborted transaction of this writer covers this offset.
definition isAborted (writer :: Int64) (offset :: Int64) (aborted :: List AbortedTxn) :: Bool is
  match aborted with
  | Nil -> false
  | Cons a rest -> (a.abortedWriter == writer && offset >= a.firstOffset && offset <= a.lastOffset) || isAborted writer offset rest
  end
end

-- The entries a consumer may read from a log, in offset order: data entries
-- from the fetch offset up to the limit, without the aborted ones when it
-- reads committed. The log is newest first, so walking it and consing gives
-- offset order, and the walk stops below the fetch offset.
definition readable (es :: List LogEntry) (from :: Int64) (limit :: Int64) (committedOnly :: Bool) (aborted :: List AbortedTxn) (acc :: List FetchedRecord) :: List FetchedRecord is
  match es with
  | Nil -> acc
  | Cons e rest ->
      match e with
      | DataEntry o r w tx ->
          if o < from then acc else
          if o >= limit then readable rest from limit committedOnly aborted acc else
          if committedOnly && tx && isAborted w o aborted then readable rest from limit committedOnly aborted acc else
            readable rest from limit committedOnly aborted (Cons (FetchedRecord o r) acc)
      | ControlEntry o w c ->
          if o < from then acc else readable rest from limit committedOnly aborted acc
      end
  end
end

definition lastOffsetOf (rs :: List FetchedRecord) (otherwise :: Int64) :: Int64 is
  match rs with
  | Nil -> otherwise
  | Cons h t -> lastOffsetOf t h.offset
  end
end

-- Where the next fetch starts: past the last record taken, when the fetch
-- stopped at maxRecords; otherwise at the limit, past every entry skipped.
definition nextFetchOffset (from :: Int64) (limit :: Int64) (taken :: List FetchedRecord) (all :: List FetchedRecord) :: Int64 is
  if prelude.length taken < prelude.length all then
    (match taken with
     | Nil -> from
     | Cons h t -> prelude.saturating (lastOffsetOf taken from + 1)
     end)
  else max64 from limit
end

definition fetch (tp :: TopicPartition) (from :: Int64) (maxRecords :: Int32) (isolation :: IsolationLevel) (b :: BrokerState) :: Pair FetchResult BrokerState fails with KafkaError is
  if !(knownPartition tp b) then raise UnknownTopicOrPartition else
  let l = logOf tp b in
  let hw = highWatermark l in
  let lso = lastStableOffset l in
  if from < 0 || from > hw then raise OffsetOutOfRange else
  let committedOnly = (match isolation with | ReadUncommitted -> false | ReadCommitted -> true end) in
  let limit = (if committedOnly then lso else hw) in
  let all = readable l.entries from limit committedOnly l.abortedTxns [] in
  let taken = prelude.take maxRecords all in
  Pair (FetchResult taken (nextFetchOffset from limit taken all) hw lso) b
end

definition listOffsets (tp :: TopicPartition) (spec :: OffsetSpec) (isolation :: IsolationLevel) (b :: BrokerState) :: Pair Int64 BrokerState fails with KafkaError is
  if !(knownPartition tp b) then raise UnknownTopicOrPartition else
  let l = logOf tp b in
  match spec with
  | Earliest -> Pair 0 b
  | Latest ->
      match isolation with
      | ReadUncommitted -> Pair (highWatermark l) b
      | ReadCommitted -> Pair (lastStableOffset l) b
      end
  end
end

-- ---------------------------------------------------------------------------
-- Producer ids and transactions
-- ---------------------------------------------------------------------------

definition newProducer (txid :: Maybe Text) (b :: BrokerState) :: Pair ProducerIdAndEpoch BrokerState is
  let pid = b.nextProducerId in
  let withEntry = b with producers = prelude.put pid (ProducerEntry 0 txid NoTxn) b.producers, nextProducerId = prelude.saturating (pid + 1) in
  let mapped = (match txid with
                | Nothing -> withEntry
                | Just id -> withEntry with transactionalIds = prelude.put id pid withEntry.transactionalIds
                end) in
  Pair (ProducerIdAndEpoch pid 0) mapped
end

-- InitProducerId. A transactional id that is already known keeps its
-- producer id and gets the next epoch, which fences every older instance;
-- its open transaction is aborted.
definition initProducerId (txid :: Maybe Text) (b :: BrokerState) :: Pair ProducerIdAndEpoch BrokerState fails with KafkaError is
  match txid with
  | Nothing -> newProducer Nothing b
  | Just id ->
      if id == "" then raise InvalidRequest else
      match prelude.lookup id b.transactionalIds with
      | Nothing -> newProducer txid b
      | Just pid ->
          match prelude.lookup pid b.producers with
          | Nothing -> newProducer txid b
          | Just entry ->
              let cleared = finishTxn pid false entry.txn b in
              if entry.epoch < Int16.max then
                let bumped = prelude.saturating (entry.epoch + 1) in
                Pair (ProducerIdAndEpoch pid bumped) (putProducer pid (entry with epoch = bumped, txn = NoTxn) cleared)
              else newProducer txid cleared
          end
      end
  end
end

-- The checks every transactional request makes: the transactional id maps
-- to this producer id, and the epoch is current. An older epoch is a fenced
-- zombie.
definition checkTxnProducer (txid :: Text) (pid :: Int64) (epoch :: Int16) (b :: BrokerState) :: ProducerEntry fails with KafkaError is
  match prelude.lookup txid b.transactionalIds with
  | Nothing -> raise InvalidProducerIdMapping
  | Just mapped ->
      if mapped != pid then raise InvalidProducerIdMapping else
      match prelude.lookup pid b.producers with
      | Nothing -> raise InvalidProducerIdMapping
      | Just entry ->
          if epoch < entry.epoch then raise ProducerFenced else
          if epoch > entry.epoch then raise InvalidProducerEpoch else entry
      end
  end
end

definition allKnown (tps :: List TopicPartition) (b :: BrokerState) :: Bool is
  match tps with
  | Nil -> true
  | Cons h t -> knownPartition h b && allKnown t b
  end
end

definition unionPartitions (xs :: List TopicPartition) (ys :: List TopicPartition) :: List TopicPartition is
  match xs with
  | Nil -> ys
  | Cons h t -> if ys contains h then unionPartitions t ys else unionPartitions t (Cons h ys)
  end
end

definition putProducer (pid :: Int64) (entry :: ProducerEntry) (b :: BrokerState) :: BrokerState is
  b with producers = prelude.put pid entry b.producers
end

definition addPartitionsToTxn (txid :: Text) (pid :: Int64) (epoch :: Int16) (tps :: List TopicPartition) (b :: BrokerState) :: Pair Unit BrokerState fails with KafkaError is
  let entry = checkTxnProducer txid pid epoch b in
  if !(allKnown tps b) then raise UnknownTopicOrPartition else
  let next = (match entry.txn with
              | NoTxn -> Ongoing (unionPartitions tps []) []
              | Ongoing ps os -> Ongoing (unionPartitions tps ps) os
              end) in
  Pair unitValue (putProducer pid (entry with txn = next) b)
end

definition pendingFor (group :: Text) (offsets :: List OffsetEntry) (acc :: List PendingOffset) :: List PendingOffset is
  match offsets with
  | Nil -> acc
  | Cons o rest -> pendingFor group rest (Cons (PendingOffset group o) acc)
  end
end

-- AddOffsetsToTxn and TxnOffsetCommit in one: the offsets are committed only
-- if the transaction commits.
definition txnOffsetCommit (txid :: Text) (pid :: Int64) (epoch :: Int16) (group :: Text) (offsets :: List OffsetEntry) (b :: BrokerState) :: Pair Unit BrokerState fails with KafkaError is
  if group == "" then raise InvalidGroupId else
  let entry = checkTxnProducer txid pid epoch b in
  let next = (match entry.txn with
              | NoTxn -> Ongoing [] (pendingFor group offsets [])
              | Ongoing ps os -> Ongoing ps (pendingFor group offsets os)
              end) in
  Pair unitValue (putProducer pid (entry with txn = next) b)
end

-- Writes a commit or abort marker to one partition of a transaction.
definition writeMarker (pid :: Int64) (commit :: Bool) (l :: PartitionLog) :: PartitionLog is
  let aborted = (if commit then l.abortedTxns else
                   (match prelude.lookup pid l.openTxns with
                    | Nothing -> l.abortedTxns
                    | Just first -> Cons (AbortedTxn pid first l.logEndOffset) l.abortedTxns
                    end)) in
  l with entries = Cons (ControlEntry l.logEndOffset pid commit) l.entries,
         logEndOffset = prelude.saturating (l.logEndOffset + 1),
         openTxns = prelude.delete pid l.openTxns,
         abortedTxns = aborted
end

definition writeMarkers (pid :: Int64) (commit :: Bool) (tps :: List TopicPartition) (b :: BrokerState) :: BrokerState is
  match tps with
  | Nil -> b
  | Cons tp rest -> writeMarkers pid commit rest (putLog tp (writeMarker pid commit (logOf tp b)) b)
  end
end

definition applyOffsets (os :: List PendingOffset) (b :: BrokerState) :: BrokerState is
  match os with
  | Nil -> b
  | Cons o rest ->
      applyOffsets rest (b with committed = prelude.put (GroupPartition o.pendingGroup o.pendingEntry.topicPartition) o.pendingEntry.offset b.committed)
  end
end

-- Ends a transaction: markers in every partition it touched and, on
-- commit, its offsets. The producer's own entry is left to the caller.
definition finishTxn (pid :: Int64) (commit :: Bool) (txn :: TxnState) (b :: BrokerState) :: BrokerState is
  match txn with
  | NoTxn -> b
  | Ongoing ps os ->
      let marked = writeMarkers pid commit ps b in
      if commit then applyOffsets (reversePending os []) marked else marked
  end
end

definition reversePending (os :: List PendingOffset) (acc :: List PendingOffset) :: List PendingOffset is
  match os with
  | Nil -> acc
  | Cons h t -> reversePending t (Cons h acc)
  end
end

definition endTxn (txid :: Text) (pid :: Int64) (epoch :: Int16) (commit :: Bool) (b :: BrokerState) :: Pair Unit BrokerState fails with KafkaError is
  let entry = checkTxnProducer txid pid epoch b in
  match entry.txn with
  | NoTxn -> raise InvalidTxnState
  | Ongoing ps os ->
      Pair unitValue (putProducer pid (entry with txn = NoTxn) (finishTxn pid commit entry.txn b))
  end
end

-- ---------------------------------------------------------------------------
-- Groups
-- ---------------------------------------------------------------------------

definition groupOf (g :: Text) (b :: BrokerState) :: Group is
  match prelude.lookup g b.groups with
  | Nothing -> emptyGroup unitValue
  | Just group -> group
  end
end

definition putGroup (g :: Text) (group :: Group) (b :: BrokerState) :: BrokerState is
  b with groups = prelude.put g group b.groups
end

-- The members, in member id order, that subscribe to a topic.
definition subscribersOf (topic :: Text) (subs :: List (Entry Text (List Text))) :: List Text is
  match subs with
  | Nil -> []
  | Cons e rest ->
      if e.value contains topic then Cons e.key (subscribersOf topic rest) else subscribersOf topic rest
  end
end

definition assignTo (member :: Text) (tp :: TopicPartition) (a :: KeyVal Text (List TopicPartition)) :: KeyVal Text (List TopicPartition) is
  match prelude.lookup member a with
  | Nothing -> prelude.put member [tp] a
  | Just tps -> prelude.put member (tps ++ [tp]) a
  end
end

-- The partitions of a topic go to its subscribers in turn, in member id
-- order, starting again from the first when every subscriber has one:
-- every partition has exactly one owner. `waiting` is the subscribers still
-- to get one in this round.
definition assignPartitions (topic :: Text) (ps :: List Int32) (owners :: List Text) (waiting :: List Text) (a :: KeyVal Text (List TopicPartition)) :: KeyVal Text (List TopicPartition) is
  match ps with
  | Nil -> a
  | Cons p rest ->
      match waiting with
      | Cons owner later -> assignPartitions topic rest owners later (assignTo owner (TopicPartition topic p) a)
      | Nil ->
          match owners with
          | Nil -> a
          | Cons owner later -> assignPartitions topic rest owners later (assignTo owner (TopicPartition topic p) a)
          end
      end
  end
end

definition subscribedTopics (subs :: List (Entry Text (List Text))) (acc :: Set Text) :: Set Text is
  match subs with
  | Nil -> acc
  | Cons e rest -> subscribedTopics rest (prelude.union acc (prelude.setOf e.value))
  end
end

definition assignTopics (topics :: List Text) (subs :: List (Entry Text (List Text))) (b :: BrokerState) (a :: KeyVal Text (List TopicPartition)) :: KeyVal Text (List TopicPartition) is
  match topics with
  | Nil -> a
  | Cons topic rest ->
      match partitionCountOf topic b with
      | Nothing -> assignTopics rest subs b a
      | Just n -> assignTopics rest subs b (let owners = subscribersOf topic subs in assignPartitions topic (partitionsBelow n) owners owners a)
      end
  end
end

definition emptyAssignments (members :: List Text) (a :: KeyVal Text (List TopicPartition)) :: KeyVal Text (List TopicPartition) is
  match members with
  | Nil -> a
  | Cons m rest -> emptyAssignments rest (prelude.put m [] a)
  end
end

-- The coordinator's assignment for the group's members and subscriptions.
definition computeAssignment (subscriptions :: KeyVal Text (List Text)) (b :: BrokerState) :: KeyVal Text (List TopicPartition) is
  let subs = prelude.entries subscriptions in
  assignTopics (prelude.toList (subscribedTopics subs (prelude.setOf []))) subs b
    (emptyAssignments (prelude.keys subscriptions) (prelude.keyValOf []))
end

-- A new generation of the group, with a fresh assignment.
definition rebalance (group :: Group) (b :: BrokerState) :: Group is
  group with groupGeneration = prelude.saturating (group.groupGeneration + 1), assignment = computeAssignment group.subscriptions b
end

definition subscribesTo (topic :: Text) (group :: Group) :: Bool is
  !(prelude.isEmpty (subscribersOf topic (prelude.entries group.subscriptions)))
end

definition rebalanceGroups (topic :: Text) (gs :: List (Entry Text Group)) (b :: BrokerState) (acc :: KeyVal Text Group) :: KeyVal Text Group is
  match gs with
  | Nil -> acc
  | Cons e rest ->
      rebalanceGroups topic rest b (prelude.put e.key (if subscribesTo topic e.value then rebalance e.value b else e.value) acc)
  end
end

-- A topic's partitions changed: every group that subscribes to it
-- rebalances.
definition rebalanceTopic (topic :: Text) (b :: BrokerState) :: BrokerState is
  b with groups = rebalanceGroups topic (prelude.entries b.groups) b b.groups
end

-- JoinGroup. A new member, or a member whose subscription changed, starts a
-- new generation; a member that rejoins unchanged learns the current one.
definition joinGroup (g :: Text) (member :: Text) (topics :: List Text) (b :: BrokerState) :: Pair Int32 BrokerState fails with KafkaError is
  if g == "" then raise InvalidGroupId else
  if member == "" then raise UnknownMemberId else
  let group = groupOf g b in
  let wanted = prelude.toList (prelude.setOf topics) in
  match prelude.lookup member group.subscriptions with
  | Just existing ->
      if existing == wanted then Pair group.groupGeneration b else
        let next = rebalance (group with subscriptions = prelude.put member wanted group.subscriptions) b in
        Pair next.groupGeneration (putGroup g next b)
  | Nothing ->
      let next = rebalance (group with subscriptions = prelude.put member wanted group.subscriptions) b in
      Pair next.groupGeneration (putGroup g next b)
  end
end

-- The checks of SyncGroup, Heartbeat and OffsetCommit: the member belongs to
-- the group, at its current generation.
definition checkMember (g :: Text) (member :: Text) (generation :: Int32) (b :: BrokerState) :: Group fails with KafkaError is
  if g == "" then raise InvalidGroupId else
  let group = groupOf g b in
  match prelude.lookup member group.subscriptions with
  | Nothing -> raise UnknownMemberId
  | Just topics -> if generation != group.groupGeneration then raise IllegalGeneration else group
  end
end

definition syncGroup (g :: Text) (member :: Text) (generation :: Int32) (b :: BrokerState) :: Pair (List TopicPartition) BrokerState fails with KafkaError is
  let group = checkMember g member generation b in
  match prelude.lookup member group.assignment with
  | Nothing -> Pair [] b
  | Just tps -> Pair tps b
  end
end

definition heartbeat (g :: Text) (member :: Text) (generation :: Int32) (b :: BrokerState) :: Pair Unit BrokerState fails with KafkaError is
  let group = checkMember g member generation b in Pair unitValue b
end

definition leaveGroup (g :: Text) (member :: Text) (b :: BrokerState) :: Pair Unit BrokerState fails with KafkaError is
  let group = groupOf g b in
  match prelude.lookup member group.subscriptions with
  | Nothing -> raise UnknownMemberId
  | Just topics ->
      Pair unitValue (putGroup g (rebalance (group with subscriptions = prelude.delete member group.subscriptions) b) b)
  end
end

definition memberViews (a :: List (Entry Text (List TopicPartition))) :: List MemberAssignment is
  match a with
  | Nil -> []
  | Cons e rest -> Cons (MemberAssignment e.key e.value) (memberViews rest)
  end
end

definition describeGroup (g :: Text) (b :: BrokerState) :: Pair GroupView BrokerState is
  let group = groupOf g b in Pair (GroupView group.groupGeneration (memberViews (prelude.entries group.assignment))) b
end

definition commitAll (g :: Text) (offsets :: List OffsetEntry) (b :: BrokerState) :: BrokerState is
  match offsets with
  | Nil -> b
  | Cons o rest -> commitAll g rest (b with committed = prelude.put (GroupPartition g o.topicPartition) o.offset b.committed)
  end
end

definition offsetPartitions (offsets :: List OffsetEntry) :: List TopicPartition is
  match offsets with
  | Nil -> []
  | Cons o rest -> Cons o.topicPartition (offsetPartitions rest)
  end
end

-- OffsetCommit. A member commits at its current generation. A consumer
-- outside any group commits with member "" and generation -1, which only an
-- empty group accepts.
definition offsetCommit (g :: Text) (member :: Text) (generation :: Int32) (offsets :: List OffsetEntry) (b :: BrokerState) :: Pair Unit BrokerState fails with KafkaError is
  if g == "" then raise InvalidGroupId else
  if !(allKnown (offsetPartitions offsets) b) then raise UnknownTopicOrPartition else
  let group = groupOf g b in
  if member == "" && generation == -1 then
    (if prelude.isEmpty group.subscriptions then Pair unitValue (commitAll g offsets b) else raise IllegalGeneration)
  else
    let checked = checkMember g member generation b in Pair unitValue (commitAll g offsets b)
end

definition offsetFetch (g :: Text) (tp :: TopicPartition) (b :: BrokerState) :: Pair (Maybe Int64) BrokerState is
  Pair (prelude.lookup (GroupPartition g tp) b.committed) b
end
