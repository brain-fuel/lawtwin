unit lawtwin.kafka

import lawtwin.kafka.model as model (TopicPartition, IsolationLevel, OffsetSpec,
KafkaError, Header,
Record, ProducerTag, ProducerIdAndEpoch, FetchedRecord, FetchResult,
OffsetEntry, MemberAssignment,
GroupView, BrokerState)

-- The Kafka contract. Broker is the cluster as the wire protocol sees it:
-- one operation for each request a client sends. Admin and
-- GroupCoordinator are what a client library offers over the same
-- requests; the spec handler `cluster` answers all three from one model
-- state. Producer, Partitioner, Consumer and Transactions are clients, and
-- their spec handlers are written over Broker. The set `reference` runs
-- every law over all the spec handlers together. Every law binds every
-- lawful handler: the reference model, the Kafka twin, and a real Kafka
-- cluster reached through a real client.
--
-- The laws hold on a cluster that already holds data. Where a law needs a
-- fresh topic, it creates one and claims nothing when the topic exists.

-- ---------------------------------------------------------------------------
-- The cluster a test runs against
-- ---------------------------------------------------------------------------

-- A connection to a cluster: every native handler of a case is made with
-- the case's one Cluster, so what a producer sends a consumer reads.
handle Cluster

connectCluster :: Unit -> Cluster
disconnectCluster :: Cluster -> Unit

resource Cluster is
  acquire is connectCluster unitValue end acquire
  release cluster is disconnectCluster cluster end release
end resource

-- ---------------------------------------------------------------------------
-- The cluster
-- ---------------------------------------------------------------------------

ability Broker with Cluster is
  createTopicsRequest :: Text -> Int32 -> Unit fails with KafkaError
  createPartitionsRequest :: Text -> Int32 -> Unit fails with KafkaError
  metadataRequest :: Text -> Maybe Int32
  produceRequest :: TopicPartition -> Maybe ProducerTag -> List Record -> Int64
  fails with KafkaError
  fetchRequest :: TopicPartition -> Int64 -> Int32 -> IsolationLevel ->
  FetchResult fails with KafkaError
  listOffsetsRequest :: TopicPartition -> OffsetSpec -> IsolationLevel -> Int64
  fails with KafkaError
  initProducerIdRequest :: Maybe Text -> ProducerIdAndEpoch fails with
  KafkaError
  addPartitionsToTxnRequest :: Text -> Int64 -> Int16 -> List TopicPartition ->
  Unit fails with KafkaError
  txnOffsetCommitRequest :: Text -> Int64 -> Int16 -> Text -> List OffsetEntry
  -> Unit fails with KafkaError
  endTxnRequest :: Text -> Int64 -> Int16 -> Bool -> Unit fails with KafkaError
  joinGroupRequest :: Text -> Text -> List Text -> Int32 fails with KafkaError
  syncGroupRequest :: Text -> Text -> Int32 -> List TopicPartition fails with
  KafkaError
  heartbeatRequest :: Text -> Text -> Int32 -> Unit fails with KafkaError
  leaveGroupRequest :: Text -> Text -> Unit fails with KafkaError
  describeGroupRequest :: Text -> GroupView
  offsetCommitRequest :: Text -> Text -> Int32 -> List OffsetEntry -> Unit fails
  with KafkaError
  offsetFetchRequest :: Text -> TopicPartition -> Maybe Int64
  laws
    law "|offsets in a partition are dense and increasing| is
      definition :
        for all (t :: Text where model.validTopicName t)
          (first :: List Record where smallBatch first) (second :: List Record
          where smallBatch second) =>
          created t 1 implies
          (let tp = TopicPartition record{ topic = t , partition = 0} in
            let a = prelude.attempt (produceRequest tp Absent first) in
              let b = prelude.attempt (produceRequest tp Absent second) in
                followsBatch a first b end let end let end let) = true
        end for all
      end definition
      description :
        "Two batches produced one after the other to one partition get offsets
      that follow on: the second starts where the first ends."
      end description
    end law

    law "|a batch reads back whole and in order| is
      definition :
        for all (t :: Text where model.validTopicName t) (batch :: List Record
          where smallBatch batch) =>
          created t 1 implies
          (let tp = TopicPartition record{ topic = t , partition = 0} in
            first matching case of prelude.attempt (produceRequest tp Absent
              batch) :
              when Left e then false
              when Right base then uncommittedFrom tp base = batch
            end case end let) = true end for all
      end definition
    end law

    law "|an idempotent retry is written once| is
      definition :
        for all (t :: Text where model.validTopicName t) (batch :: List Record
          where smallBatch batch) =>
          created t 1 implies
          (let tp = TopicPartition record{ topic = t , partition = 0} in
            first matching case of prelude.attempt (initProducerIdRequest
              Absent) :
              when Left e then false
              when Right pe then
                let tag = Present (tagOf pe 0) in
                  let first = prelude.attempt (produceRequest tp tag batch) in
                    let retry = prelude.attempt (produceRequest tp tag batch) in
                      first = retry && followsBatch first batch (prelude.attempt
                        (listOffsetsRequest tp Latest ReadUncommitted)) end let
                  end let end let
            end case end let) = true end for all
      end definition
      description :
        "A producer with an id stamps each batch with its epoch and sequence. A
      retry of a batch the partition already has gives the first write's
      offset and writes nothing."
      end description
      references : "KIP-98" end references
    end law

    law "|a gap in sequence numbers is refused| is
      definition :
        for all (t :: Text where model.validTopicName t) (batch :: List Record
          where smallBatch batch) =>
          created t 1 implies
          (first matching case of prelude.attempt (initProducerIdRequest
            Absent) :
            when Left e then false
            when Right pe then produceRequest (TopicPartition record{ topic = t
                , partition = 0}) (Present (tagOf pe 1)) batch fails with
                OutOfOrderSequenceNumber
          end case) = true end for all
      end definition
    end law

    law "|a new epoch fences the older producer| is
      definition :
        for all (t :: Text where model.validTopicName t) (txid :: Text where
          txid != "")
          (batch :: List Record where smallBatch batch) =>
          created t 1 implies
          (let tp = TopicPartition record{ topic = t , partition = 0} in
            first matching case of prelude.attempt (initProducerIdRequest (Present
              txid)) :
              when Left e then false
              when Right old then
                first matching case of prelude.attempt (initProducerIdRequest
                  (Present txid)) :
                  when Left e then false
                  when Right new then
                    fencedBy old new
                      && (addPartitionsToTxnRequest txid old.producerId
                        old.producerEpoch [tp] fails with ProducerFenced)
                      && (produceRequest tp (Present (tagOf old 0)) batch fails
                    with InvalidProducerEpoch)
                end case
            end case end let) = true end for all
      end definition
      description :
        "Initialising a transactional id again bumps its epoch. Every request
      stamped with the older epoch is refused from then on, so a zombie
      instance can no longer write."
      end description
      references : "KIP-98" end references
    end law

    law "|read-committed fetches never see open or aborted transactions| is
      definition :
        for all (t :: Text where model.validTopicName t) (txid :: Text where
          txid != "")
          (batch :: List Record where smallBatch batch) =>
          created t 1 implies transactionThenRead t txid batch false = true
        end for all
      end definition
      description :
        "While a transaction is open its records are past the last stable
      offset, which read-committed consumers do not pass. Once it aborts its
      records are skipped for ever. Read-uncommitted consumers see them both
      times."
      end description
      references : "KIP-98" end references
    end law

    law "|a committed transaction is read whole and in order| is
      definition :
        for all (t :: Text where model.validTopicName t) (txid :: Text where
          txid != "")
          (batch :: List Record where smallBatch batch) =>
          created t 1 implies transactionThenRead t txid batch true = true
        end for all
      end definition
      references : "KIP-98" end references
    end law

    law "|offsets sent in a transaction are committed only with it| is
      definition :
        for all (t :: Text where model.validTopicName t) (txid :: Text where
          txid != "")
          (g :: Text where g != "") (offset :: Int64 where offset >= 0) =>
          created t 1 implies transactionalOffsets t txid g offset = true
        end for all
      end definition
      references : "KIP-98" end references
    end law

    law "|the coordinator assigns every partition exactly once| is
      definition :
        for all (t :: Text where model.validTopicName t) (n :: Int32 where n >=
            1 && n <= 16)
          (g :: Text where g != "") (ids :: List Text where !(prelude.isEmpty
            (memberIds ids))) =>
          created t n implies
          (joinAll g (memberIds ids) [t] && coversOnce t n (describeGroupRequest
            g)) = true end for all
      end definition
      description :
        "After members join, the partitions of the topic they subscribe to are
      shared out so that each partition has exactly one owner in the
      generation."
      end description
      references : "KIP-848" end references
    end law

    law "|a member of an older generation cannot commit| is
      definition :
        for all (t :: Text where model.validTopicName t) (g :: Text where g !=
            "")
          (one :: Text where one != "") (other :: Text where other != "" &&
            other != one) =>
          created t 1 implies
          (first matching case of prelude.attempt (joinGroupRequest g one [t]) :
            when Left e then false
            when Right old then
              first matching case of prelude.attempt (joinGroupRequest g other
                [t]) :
                when Left e then false
                when Right new then
                  old < new
                    && (offsetCommitRequest g one old [OffsetEntry record{
                      topicPartition = (TopicPartition record{ topic = t ,
                        partition = 0}) , offset = 0}] fails with
                      IllegalGeneration)
                    && (heartbeatRequest g one old fails with IllegalGeneration)
              end case
          end case) = true end for all
      end definition
      description :
        "A new member starts a new generation. A member still at the old one is
      told to rejoin, and its commits are refused, so it cannot overwrite the
      offsets of the partitions it may have lost."
      end description
    end law

    law "|the stable offset never passes the high watermark| is
      definition :
        for all (t :: Text where model.validTopicName t) (txid :: Text where
          txid != "")
          (batch :: List Record where smallBatch batch) =>
          created t 1 implies stableBelowHigh t txid batch = true end for all
      end definition
    end law
  end laws
end ability

-- The reference model: each request is the model's checked definition of
-- it, over the cluster's state. Admin and GroupCoordinator are answered from
-- the same state, so what an admin creates a broker request sees.
handler cluster for Broker, Admin, GroupCoordinator with state state ::
  BrokerState start model.emptyBroker unitValue is
  operation createTopicsRequest by model.createTopic end operation
  operation createPartitionsRequest by model.createPartitions end operation
  operation metadataRequest by model.metadata end operation
  operation produceRequest by model.produce end operation
  operation fetchRequest by model.fetch end operation
  operation listOffsetsRequest by model.listOffsets end operation
  operation initProducerIdRequest by model.initProducerId end operation
  operation addPartitionsToTxnRequest by model.addPartitionsToTxn end operation
  operation txnOffsetCommitRequest by model.txnOffsetCommit end operation
  operation endTxnRequest by model.endTxn end operation
  operation joinGroupRequest by model.joinGroup end operation
  operation syncGroupRequest by model.syncGroup end operation
  operation heartbeatRequest by model.heartbeat end operation
  operation leaveGroupRequest by model.leaveGroup end operation
  operation describeGroupRequest by model.describeGroup end operation
  operation offsetCommitRequest by model.offsetCommit end operation
  operation offsetFetchRequest by model.offsetFetch end operation
  operation createTopic by model.createTopic end operation
  operation createPartitions by model.createPartitions end operation
  operation partitionsFor by model.metadata end operation
  operation listOffsets by model.listOffsets end operation
  operation joinGroup by model.joinGroup end operation
  operation syncGroup by model.syncGroup end operation
  operation heartbeat by model.heartbeat end operation
  operation leaveGroup by model.leaveGroup end operation
  operation describeGroup by model.describeGroup end operation
  operation commitOffsets by model.offsetCommit end operation
  operation fetchOffset by model.offsetFetch end operation
end handler

-- Every ability answered by spec handlers: the cluster, and clients over it.
handlers reference is cluster, kafkaProducer, kafkaConsumer, kafkaTransactions,
  murmurPartitioner end handlers

-- ---------------------------------------------------------------------------
-- Helpers for the laws
-- ---------------------------------------------------------------------------

-- A topic made with n partitions, now.
procedure created (t :: Text) (n :: Int32) -> Bool uses Broker is
  prelude.isRight (prelude.attempt (createTopicsRequest t n))
end procedure

-- A batch of one to a hundred records: one fetch reads it whole.
function smallBatch (batch :: List Record) -> Bool is
  prelude.length batch >= 1 && prelude.length batch <= 100
end function

-- Distinct, non-empty member ids, from any list of texts.
function memberIds (ms :: List Text) -> List Text is
  prelude.toList (prelude.sortedSetRemove "" (prelude.sortedSetOf ms))
end function

function followsBatch (a :: Either KafkaError Int64) (batch :: List Record) (b
  :: Either KafkaError Int64) -> Bool is
  first matching case of a :
    when Left e then false
    when Right x then
      first matching case of b :
        when Left e then false
        when Right y then y = x + prelude.length batch
      end case
  end case
end function

function tagOf (pe :: ProducerIdAndEpoch) (sequence :: Int32) -> ProducerTag is
  ProducerTag record{ producerId = pe.producerId , producerEpoch =
      pe.producerEpoch , baseSequence = sequence}
end function

-- The newer instance keeps the producer id with a later epoch, or, once
-- the epoch is exhausted, gets a new producer id.
function fencedBy (old :: ProducerIdAndEpoch) (new :: ProducerIdAndEpoch) ->
  Bool is
  (new.producerId = old.producerId && new.producerEpoch > old.producerEpoch) ||
    new.producerId != old.producerId
end function

function recordsOf (rs :: List FetchedRecord) -> List Record is
  first matching case of rs :
    when Nil then []
    when Cons r rest then Cons r.entry (recordsOf rest)
  end case
end function

-- The records from an offset on, as a consumer at an isolation level reads
-- them in one fetch.
procedure readFrom (tp :: TopicPartition) (offset :: Int64) (isolation ::
  IsolationLevel) -> List Record uses Broker is
  first matching case of prelude.attempt (fetchRequest tp offset 1000 isolation)
    :
    when Left e then []
    when Right fr then recordsOf fr.records
  end case
end procedure

procedure uncommittedFrom (tp :: TopicPartition) (offset :: Int64) -> List
  Record uses Broker is
  readFrom tp offset ReadUncommitted
end procedure

procedure committedFrom (tp :: TopicPartition) (offset :: Int64) -> List Record
  uses Broker is
  readFrom tp offset ReadCommitted
end procedure

-- Writes a batch in a transaction, checks what each isolation level sees
-- while it is open, then commits or aborts it and checks again.
procedure transactionThenRead (t :: Text) (txid :: Text) (batch :: List Record)
  (commit :: Bool) -> Bool uses Broker is
  let tp = TopicPartition record{ topic = t , partition = 0} in
    first matching case of prelude.attempt (initProducerIdRequest (Present txid)) :
      when Left e then false
      when Right pe then
        first matching case of prelude.attempt (addPartitionsToTxnRequest txid
          pe.producerId pe.producerEpoch [tp]) :
          when Left e then false
          when Right u then
            first matching case of prelude.attempt (produceRequest tp (Present
              (tagOf pe 0)) batch) :
              when Left e then false
              when Right base then
                let hiddenWhileOpen = committedFrom tp base = [] in
                  let seenUncommitted = uncommittedFrom tp base = batch in
                    first matching case of prelude.attempt (endTxnRequest txid
                      pe.producerId pe.producerEpoch commit) :
                      when Left e then false
                      when Right done then
                        hiddenWhileOpen && seenUncommitted && uncommittedFrom tp
                          base = batch
                        && (if commit then committedFrom tp base = batch else
                          committedFrom tp base = [] end if)
                    end case end let end let
            end case
        end case
    end case end let
end procedure

procedure transactionalOffsets (t :: Text) (txid :: Text) (g :: Text) (offset ::
  Int64) -> Bool uses Broker is
  let tp = TopicPartition record{ topic = t , partition = 0} in
    let before = offsetFetchRequest g tp in
      first matching case of prelude.attempt (initProducerIdRequest (Present txid))
        :
        when Left e then false
        when Right pe then
          let sent = prelude.attempt (txnOffsetCommitRequest txid pe.producerId
              pe.producerEpoch g [OffsetEntry record{ topicPartition = tp ,
                offset
                = offset}]) in
            let aborted = prelude.attempt (endTxnRequest txid pe.producerId
                pe.producerEpoch false) in
              let afterAbort = offsetFetchRequest g tp in
                let resent = prelude.attempt (txnOffsetCommitRequest txid
                    pe.producerId pe.producerEpoch g [OffsetEntry record{
                      topicPartition = tp , offset = offset}]) in
                  let committed = prelude.attempt (endTxnRequest txid
                      pe.producerId pe.producerEpoch true) in
                    prelude.isRight sent && prelude.isRight aborted &&
                      afterAbort = before
                      && prelude.isRight resent && prelude.isRight committed &&
                      offsetFetchRequest g tp = Present offset end let end let
              end let end let end let
      end case end let end let
end procedure

procedure joinAll (g :: Text) (ms :: List Text) (topics :: List Text) -> Bool
  uses Broker is
  first matching case of ms :
    when Nil then true
    when Cons m rest then prelude.isRight (prelude.attempt (joinGroupRequest g m
        topics)) && joinAll g rest topics
  end case
end procedure

function ownedOf (t :: Text) (ms :: List MemberAssignment) -> List Int32 is
  first matching case of ms :
    when Nil then []
    when Cons m rest then partitionsOfTopic t m.assigned ++ ownedOf t rest
  end case
end function

function partitionsOfTopic (t :: Text) (tps :: List TopicPartition) -> List
  Int32 is
  first matching case of tps :
    when Nil then []
    when Cons tp rest then if tp.topic = t then Cons tp.partition
        (partitionsOfTopic t rest) else partitionsOfTopic t rest end if
  end case
end function

-- Each partition of the topic is owned by exactly one member: the owned
-- partitions are all of them, none twice.
function coversOnce (t :: Text) (n :: Int32) (view :: GroupView) -> Bool is
  let owned = ownedOf t view.members in
    prelude.length owned = n && prelude.sortedSetOf owned = prelude.sortedSetOf
      (prelude.range 0 n) end let
end function

procedure stableBelowHigh (t :: Text) (txid :: Text) (batch :: List Record) ->
  Bool uses Broker is
  let tp = TopicPartition record{ topic = t , partition = 0} in
    first matching case of prelude.attempt (initProducerIdRequest (Present txid)) :
      when Left e then false
      when Right pe then
        let added = prelude.attempt (addPartitionsToTxnRequest txid
            pe.producerId pe.producerEpoch [tp]) in
          let written = prelude.attempt (produceRequest tp (Present (tagOf pe 0))
              batch) in
            first matching case of prelude.attempt (fetchRequest tp 0 1000
              ReadUncommitted) :
              when Left e then false
              when Right fr then
                prelude.isRight added && prelude.isRight written &&
                  fr.lastStableOffset <= fr.highWatermark
                && (first matching case of written : when Right base then
                  fr.lastStableOffset <= base when Left e then false end case)
            end case end let end let
    end case end let
end procedure

-- ---------------------------------------------------------------------------
-- Clients: what a client library keeps between calls
-- ---------------------------------------------------------------------------

-- How a producer picks the partition of a record.
type PartitionChoice is one of
  | ToPartition of type Int32
  | ByKey
end type

type ProducerRecord is a record{

  destination :: Text
  choice :: PartitionChoice
  payload :: Record}
end type

type RecordMetadata is a record{

  sentTo :: TopicPartition
  sentAt :: Int64}
end type

type ConsumerRecord is a record{

  receivedFrom :: TopicPartition
  receivedAt :: Int64
  received :: Record}
end type

-- A send the producer may retry: where it went, and the stamp it carried.
type LastSend is a record{

  lastPartition :: TopicPartition
  lastTag :: Maybe ProducerTag
  lastRecords :: List Record}
end type

type ProducerState is a record{

  identity :: Maybe ProducerIdAndEpoch
  sequences :: KeyVal TopicPartition Int32
  lastSend :: Maybe LastSend}
end type

function freshProducer (u :: Unit) -> ProducerState is ProducerState record{
    identity = Absent , sequences = (prelude.keyValOf []) , lastSend = Absent}
end function

type ConsumerState is a record{

  group :: Maybe Text
  member :: Text
  generation :: Int32
  subscription :: List Text
  assigned :: List TopicPartition
  positions :: KeyVal TopicPartition Int64
  isolation :: IsolationLevel}
end type

function freshConsumer (u :: Unit) -> ConsumerState is
  ConsumerState record{ group = Absent , member = "" , generation = -1 ,
    subscription = [] , assigned = [] , positions = (prelude.keyValOf []) ,
    isolation = ReadUncommitted}
end function

type TransactionState is a record{

  transactionalId :: Text
  producer :: Maybe ProducerIdAndEpoch
  txnSequences :: KeyVal TopicPartition Int32
  inTransaction :: Bool
  added :: List TopicPartition
  offsetsSent :: Bool}
end type

function freshTransactions (u :: Unit) -> TransactionState is
  TransactionState record{ transactionalId = "" , producer = Absent ,
    txnSequences = (prelude.keyValOf []) , inTransaction = false , added = [] ,
    offsetsSent = false}
end function

function sequenceFor (tp :: TopicPartition) (sequences :: KeyVal TopicPartition
  Int32) -> Int32 is
  first matching case of prelude.lookup tp sequences :
    when Absent then 0
    when Present n then n
  end case
end function

function tagFor (identity :: Maybe ProducerIdAndEpoch) (sequence :: Int32) ->
  Maybe ProducerTag is
  first matching case of identity :
    when Absent then Absent
    when Present pe then Present (tagOf pe sequence)
  end case
end function

-- The partition a record goes to: the one asked for, if the topic has it,
-- or the partitioner's choice for its key.
procedure partitionOf (topic :: Text) (choice :: PartitionChoice) (r :: Record)
  -> Either KafkaError TopicPartition uses Broker, Partitioner is
  first matching case of metadataRequest topic :
    when Absent then Left UnknownTopicOrPartition
    when Present n then
      first matching case of choice :
        when ToPartition p then if p >= 0 && p < n then Right (TopicPartition
            record{ topic = topic , partition = p}) else Left
              UnknownTopicOrPartition end if
        when ByKey then Right (TopicPartition record{ topic = topic , partition
            = (choosePartition r.key n)})
      end case
  end case
end procedure

procedure producerSend (pr :: ProducerRecord) (st :: ProducerState) -> Pair
  (Either KafkaError RecordMetadata) ProducerState uses Broker, Partitioner is
  first matching case of partitionOf pr.destination pr.choice pr.payload :
    when Left e then Pair (Left e) st
    when Right tp then
      let sequence = sequenceFor tp st.sequences in
        let tag = tagFor st.identity sequence in
          first matching case of prelude.attempt (produceRequest tp tag
            [pr.payload]) :
            when Left e then Pair (Left e) st
            when Right offset then
              Pair (Right (RecordMetadata record{ sentTo = tp , sentAt =
                  offset}))
                (st with sequences = prelude.put tp (prelude.saturating
                  (sequence + 1)) st.sequences, lastSend = Present (LastSend
                    record{ lastPartition = tp , lastTag = tag , lastRecords =
                        [pr.payload]}))
          end case end let end let
  end case
end procedure

procedure producerRetry (st :: ProducerState) -> Pair (Either KafkaError
  RecordMetadata) ProducerState uses Broker is
  first matching case of st.lastSend :
    when Absent then Pair (Left IllegalState) st
    when Present l then
      first matching case of prelude.attempt (produceRequest l.lastPartition
        l.lastTag l.lastRecords) :
        when Left e then Pair (Left e) st
        when Right offset then Pair (Right (RecordMetadata record{ sentTo =
            l.lastPartition , sentAt = offset})) st
      end case
  end case
end procedure

procedure producerIdempotent (st :: ProducerState) -> Pair (Either KafkaError
  ProducerIdAndEpoch) ProducerState uses Broker is
  first matching case of prelude.attempt (initProducerIdRequest Absent) :
    when Left e then Pair (Left e) st
    when Right pe then Pair (Right pe) (ProducerState record{ identity = (Present
        pe) , sequences = (prelude.keyValOf []) , lastSend = Absent})
  end case
end procedure

function producerFlush (st :: ProducerState) -> Pair Unit ProducerState is Pair
    unitValue st end function
function identityOf (st :: ProducerState) -> Pair (Maybe ProducerIdAndEpoch)
  ProducerState is Pair st.identity st end function

-- Consumers.

function consumerRecords (tp :: TopicPartition) (rs :: List FetchedRecord) ->
  List ConsumerRecord is
  first matching case of rs :
    when Nil then []
    when Cons r rest then Cons (ConsumerRecord record{ receivedFrom = tp ,
        receivedAt = r.offset , received = r.entry}) (consumerRecords tp rest)
  end case
end function

-- The offsets a consumer commits: its position in each assigned partition
-- that has one.
function positionsToCommit (tps :: List TopicPartition) (positions :: KeyVal
  TopicPartition Int64) -> List OffsetEntry is
  first matching case of tps :
    when Nil then []
    when Cons tp rest then
      first matching case of prelude.lookup tp positions :
        when Absent then positionsToCommit rest positions
        when Present o then Cons (OffsetEntry record{ topicPartition = tp , offset
            = o}) (positionsToCommit rest positions)
      end case
  end case
end function

-- Positions kept only for the partitions still assigned.
function keepPositions (tps :: List TopicPartition) (positions :: KeyVal
  TopicPartition Int64) (acc :: KeyVal TopicPartition Int64) -> KeyVal
  TopicPartition Int64 is
  first matching case of tps :
    when Nil then acc
    when Cons tp rest then
      first matching case of prelude.lookup tp positions :
        when Absent then keepPositions rest positions acc
        when Present o then keepPositions rest positions (prelude.put tp o acc)
      end case
  end case
end function

function withAssignment (g :: Maybe Text) (m :: Text) (gen :: Int32) (topics ::
  List Text) (tps :: List TopicPartition) (c :: ConsumerState) -> ConsumerState
  is
  c with group = g, member = m, generation = gen, subscription = topics,
    assigned = tps,
    positions = keepPositions tps c.positions (prelude.keyValOf [])
end function

function withPosition (tp :: TopicPartition) (offset :: Int64) (c ::
  ConsumerState) -> ConsumerState is
  c with positions = prelude.put tp offset c.positions
end function

-- Joins the group and learns this member's partitions.
procedure consumerJoin (g :: Text) (m :: Text) (topics :: List Text) (c ::
  ConsumerState) -> Pair (Either KafkaError (List TopicPartition)) ConsumerState
  uses Broker is
  first matching case of prelude.attempt (joinGroupRequest g m topics) :
    when Left e then Pair (Left e) c
    when Right gen then
      first matching case of prelude.attempt (syncGroupRequest g m gen) :
        when Left e then Pair (Left e) c
        when Right tps then Pair (Right tps) (withAssignment (Present g) m gen
            topics tps c)
      end case
  end case
end procedure

-- Before it fetches, a member of a group checks it is still current, and
-- rejoins when a rebalance has moved the group on.
procedure consumerRefresh (c :: ConsumerState) -> Pair (Either KafkaError Unit)
  ConsumerState uses Broker is
  first matching case of c.group :
    when Absent then Pair (Right unitValue) c
    when Present group then
      first matching case of prelude.attempt (heartbeatRequest group c.member
        c.generation) :
        when Right u then Pair (Right unitValue) c
        when Left e then
          if e = IllegalGeneration || e = UnknownMemberId then
            (let s = consumerJoin group c.member c.subscription c in
              first matching case of s.first :
                when Left e2 then Pair (Left e2) s.second
                when Right tps then Pair (Right unitValue) s.second
              end case end let)
          else Pair (Left e) c end if
      end case
  end case
end procedure

-- Where a consumer reads a partition from: its position; else the group's
-- committed offset; else the earliest offset.
procedure consumerPosition (tp :: TopicPartition) (c :: ConsumerState) -> Pair
  Int64 ConsumerState uses Broker is
  first matching case of prelude.lookup tp c.positions :
    when Present o then Pair o c
    when Absent then
      let from = (first matching case of c.group :
          when Absent then 0
          when Present group then (first matching case of offsetFetchRequest group
              tp : when Absent then 0 when Present o then o end case)
        end case) in
        Pair from (withPosition tp from c) end let
  end case
end procedure

procedure pollPartitions (tps :: List TopicPartition) (n :: Int32) (c ::
  ConsumerState) (acc :: List ConsumerRecord) -> Pair (Either KafkaError (List
  ConsumerRecord)) ConsumerState uses Broker is
  first matching case of tps :
    when Nil then Pair (Right acc) c
    when Cons tp rest then
      let p = consumerPosition tp c in
        first matching case of prelude.attempt (fetchRequest tp p.first n
          c.isolation) :
          when Left e then Pair (Left e) p.second
          when Right fr then pollPartitions rest n (withPosition tp
              fr.nextOffset p.second) (acc ++ consumerRecords tp fr.records)
        end case end let
  end case
end procedure

procedure consumerPoll (n :: Int32) (c :: ConsumerState) -> Pair (Either
  KafkaError (List ConsumerRecord)) ConsumerState uses Broker is
  let refreshed = consumerRefresh c in
    first matching case of refreshed.first :
      when Left e then Pair (Left e) refreshed.second
      when Right u then pollPartitions refreshed.second.assigned n
          refreshed.second []
    end case end let
end procedure

procedure consumerCommit (c :: ConsumerState) -> Pair (Either KafkaError Unit)
  ConsumerState uses Broker is
  first matching case of c.group :
    when Absent then Pair (Left InvalidGroupId) c
    when Present group then Pair (prelude.attempt (offsetCommitRequest group
        c.member c.generation (positionsToCommit c.assigned c.positions))) c
  end case
end procedure

procedure consumerClose (c :: ConsumerState) -> Pair Unit ConsumerState uses
  Broker is
  first matching case of c.group :
    when Absent then Pair unitValue (freshConsumer unitValue)
    when Present group then let left = prelude.attempt (leaveGroupRequest group
        c.member) in Pair unitValue (freshConsumer unitValue) end let
  end case
end procedure

procedure consumerCommitted (tp :: TopicPartition) (c :: ConsumerState) -> Pair
  (Maybe Int64) ConsumerState uses Broker is
  first matching case of c.group :
    when Absent then Pair Absent c
    when Present group then Pair (offsetFetchRequest group tp) c
  end case
end procedure

function consumerAssign (tps :: List TopicPartition) (c :: ConsumerState) ->
  Pair Unit ConsumerState is
  Pair unitValue (withAssignment Absent "" -1 [] tps c)
end function

function consumerSeek (tp :: TopicPartition) (offset :: Int64) (c ::
  ConsumerState) -> Pair (Either KafkaError Unit) ConsumerState is
  if c.assigned contains tp && offset >= 0 then Pair (Right unitValue)
    (withPosition tp offset c)
  else Pair (Left IllegalState) c end if
end function

procedure consumerPositionOf (tp :: TopicPartition) (c :: ConsumerState) -> Pair
  (Either KafkaError Int64) ConsumerState uses Broker is
  if c.assigned contains tp then (let p = consumerPosition tp c in Pair (Right
      p.first) p.second end let)
  else Pair (Left IllegalState) c end if
end procedure

function consumerIsolation (level :: IsolationLevel) (c :: ConsumerState) ->
  Pair Unit ConsumerState is
  Pair unitValue (c with isolation = level)
end function

-- Transactional producers.

procedure transactionsInit (txid :: Text) (st :: TransactionState) -> Pair
  (Either KafkaError ProducerIdAndEpoch) TransactionState uses Broker is
  first matching case of prelude.attempt (initProducerIdRequest (Present txid)) :
    when Left e then Pair (Left e) st
    when Right pe then Pair (Right pe) (TransactionState record{ transactionalId
        = txid , producer = (Present pe) , txnSequences = (prelude.keyValOf []) ,
        inTransaction = false , added = [] , offsetsSent = false})
  end case
end procedure

function transactionsBegin (st :: TransactionState) -> Pair (Either KafkaError
  Unit) TransactionState is
  first matching case of st.producer :
    when Absent then Pair (Left IllegalState) st
    when Present id then
      if st.inTransaction then Pair (Left IllegalState) st else
        Pair (Right unitValue) (st with inTransaction = true, added = [],
          offsetsSent = false) end if
  end case
end function

-- Adds partitions the transaction does not have yet.
procedure transactionsAdd (tps :: List TopicPartition) (st :: TransactionState)
  -> Pair (Either KafkaError Unit) TransactionState uses Broker is
  first matching case of st.producer :
    when Absent then Pair (Left IllegalState) st
    when Present id then
      if !st.inTransaction then Pair (Left IllegalState) st else
        let missing = missingFrom tps st.added in
          if prelude.isEmpty missing then Pair (Right unitValue) st else
            first matching case of prelude.attempt (addPartitionsToTxnRequest
              st.transactionalId id.producerId id.producerEpoch missing) :
              when Left e then Pair (Left e) st
              when Right u then Pair (Right unitValue) (st with added = missing
                  ++ st.added)
            end case end if end let end if
  end case
end procedure

function missingFrom (tps :: List TopicPartition) (have :: List TopicPartition)
  -> List TopicPartition is
  first matching case of tps :
    when Nil then []
    when Cons tp rest then if have contains tp then missingFrom rest have else
        Cons tp (missingFrom rest have) end if
  end case
end function

procedure transactionsSend (pr :: ProducerRecord) (st :: TransactionState) ->
  Pair (Either KafkaError RecordMetadata) TransactionState uses Broker,
  Partitioner is
  first matching case of partitionOf pr.destination pr.choice pr.payload :
    when Left e then Pair (Left e) st
    when Right tp then
      let a = transactionsAdd [tp] st in
        first matching case of a.first :
          when Left e then Pair (Left e) a.second
          when Right u then
            let sequence = sequenceFor tp a.second.txnSequences in
              first matching case of prelude.attempt (produceRequest tp (tagFor
                a.second.producer sequence) [pr.payload]) :
                when Left e then Pair (Left e) a.second
                when Right offset then
                  Pair (Right (RecordMetadata record{ sentTo = tp , sentAt =
                      offset}))
                    (a.second with txnSequences = prelude.put tp
                      (prelude.saturating (sequence + 1)) a.second.txnSequences)
              end case end let
        end case end let
  end case
end procedure

procedure transactionsOffsets (g :: Text) (offsets :: List OffsetEntry) (st ::
  TransactionState) -> Pair (Either KafkaError Unit) TransactionState uses
  Broker is
  first matching case of st.producer :
    when Absent then Pair (Left IllegalState) st
    when Present id then
      if !st.inTransaction then Pair (Left IllegalState) st else
        first matching case of prelude.attempt (txnOffsetCommitRequest
          st.transactionalId id.producerId id.producerEpoch g offsets) :
          when Left e then Pair (Left e) st
          when Right u then Pair (Right unitValue) (st with offsetsSent = true)
        end case end if
  end case
end procedure

-- Ends the transaction. One that wrote nothing and sent no offsets ends in
-- the client alone, as Kafka's clients do.
procedure transactionsEnd (commit :: Bool) (st :: TransactionState) -> Pair
  (Either KafkaError Unit) TransactionState uses Broker is
  first matching case of st.producer :
    when Absent then Pair (Left IllegalState) st
    when Present id then
      if !st.inTransaction then Pair (Left IllegalState) st else
        if prelude.isEmpty st.added && !st.offsetsSent then Pair (Right
          unitValue) (st with inTransaction = false, added = [], offsetsSent =
            false) else
          first matching case of prelude.attempt (endTxnRequest
            st.transactionalId id.producerId id.producerEpoch commit) :
            when Left e then Pair (Left e) st
            when Right u then Pair (Right unitValue) (st with inTransaction =
                false, added = [], offsetsSent = false)
          end case end if end if
  end case
end procedure

procedure transactionsCommit (st :: TransactionState) -> Pair (Either KafkaError
  Unit) TransactionState uses Broker is transactionsEnd true st end procedure
procedure transactionsAbort (st :: TransactionState) -> Pair (Either KafkaError
  Unit) TransactionState uses Broker is transactionsEnd false st end procedure

-- ---------------------------------------------------------------------------
-- Admin
-- ---------------------------------------------------------------------------

ability Admin with Cluster is
  createTopic :: Text -> Int32 -> Unit fails with KafkaError
  createPartitions :: Text -> Int32 -> Unit fails with KafkaError
  partitionsFor :: Text -> Maybe Int32
  listOffsets :: TopicPartition -> OffsetSpec -> IsolationLevel -> Int64 fails
  with KafkaError
  laws
    law "|a new topic has the partitions asked for| is
      definition :
        for all (t :: Text where model.validTopicName t) (n :: Int32 where n >=
            1 && n <= 64) =>
          prelude.isRight (prelude.attempt (createTopic t n)) implies
          partitionsFor t = Present n end for all
      end definition
    end law

    law "|a topic is created once| is
      definition :
        for all (t :: Text where model.validTopicName t) (n :: Int32 where n >=
            1 && n <= 64) =>
          (let first = prelude.attempt (createTopic t n) in createTopic t n
          end let) fails with TopicAlreadyExists end for all
      end definition
    end law

    law "|a topic's partitions only grow| is
      definition :
        for all (t :: Text where model.validTopicName t) (n :: Int32 where n >=
            1 && n <= 64) =>
          prelude.isRight (prelude.attempt (createTopic t n)) implies
          ((createPartitions t n fails with InvalidPartitions)
            && prelude.isRight (prelude.attempt (createPartitions t
              (prelude.saturating (n + 1))))
            && partitionsFor t = Present (prelude.saturating (n + 1))) = true
        end for all
      end definition
    end law

    law "|a new topic starts at offset zero| is
      definition :
        for all (t :: Text where model.validTopicName t) (n :: Int32 where n >=
            1 && n <= 64) =>
          prelude.isRight (prelude.attempt (createTopic t n)) implies
          (prelude.attempt (listOffsets (TopicPartition record{ topic = t ,
            partition = 0}) Earliest ReadUncommitted) = Right 0
            && prelude.attempt (listOffsets (TopicPartition record{ topic = t ,
              partition = 0}) Latest ReadCommitted) = Right 0) = true
        end for all
      end definition
    end law

    law "|an invalid topic name is refused| is
      definition :
        for all (n :: Int32 where n >= 1 && n <= 64) =>
          (createTopic "" n fails with InvalidTopic) = true and (createTopic
            ".." n fails with InvalidTopic) = true end for all
      end definition
    end law
  end laws
end ability

-- ---------------------------------------------------------------------------
-- Partitioner
-- ---------------------------------------------------------------------------

-- How a producer maps a key to a partition: Kafka's murmur2 over the key's
-- octets, made positive, modulo the partitions.
ability Partitioner with Cluster is
  choosePartition :: Maybe Bytes -> Int32 -> Int32
  laws
    law "|a chosen partition exists| is
      definition :
        for all (key :: Maybe Bytes) (n :: Int32 where n >= 1 && n <= 1024) =>
          (let p = choosePartition key n in p >= 0 && p < n end let) = true
        end for all
      end definition
    end law

    law "|a key always goes to the same partition| is
      definition :
        for all (key :: Bytes) (n :: Int32 where n >= 1 && n <= 1024) =>
          choosePartition (Present key) n = choosePartition (Present key) n
        end for all
      end definition
    end law
  end laws
end ability

handler murmurPartitioner for Partitioner is
  operation choosePartition key n is
    first matching case of key :
      when Absent then 0
      when Present k then if n >= 1 then prelude.Int32 (prelude.rem (toPositive
          (murmur2 k)) n) else 0 end if
    end case
  end operation
end handler

-- Kafka's murmur2 (org.apache.kafka.common.utils.Utils.murmur2) over a
-- key's octets, in 32 bits.
function murmur2 (key :: Bytes) -> UInt32 is
  let h = murmurChunks (prelude.octets key) (xor32 2538058380 (prelude.wrapping
      (prelude.length key))) in
    let h1 = mul32 (xor32 h (prelude.wrapping (prelude.quot h 8192))) (murmurM
        unitValue) in
      xor32 h1 (prelude.wrapping (prelude.quot h1 32768)) end let end let
end function

function murmurM (u :: Unit) -> UInt32 is 1540483477 end function

function murmurChunks (octets :: List UInt8) (h :: UInt32) -> UInt32 is
  first matching case of octets :
    when Nil then h
    when Cons b0 rest1 then
      first matching case of rest1 :
        when Nil then mul32 (xor32 h (prelude.UInt32 b0)) (murmurM unitValue)
        when Cons b1 rest2 then
          first matching case of rest2 :
            when Nil then mul32 (xor32 (xor32 h (prelude.wrapping (b1 * 256)))
                (prelude.UInt32 b0)) (murmurM unitValue)
            when Cons b2 rest3 then
              first matching case of rest3 :
                when Nil then mul32 (xor32 (xor32 (xor32 h (prelude.wrapping (b2
                    * 65536))) (prelude.wrapping (b1 * 256))) (prelude.UInt32
                      b0))
                    (murmurM unitValue)
                when Cons b3 rest4 then
                  let k0 = mul32 (prelude.wrapping (b0 + b1 * 256 + b2 * 65536 +
                      b3 * 16777216)) (murmurM unitValue) in
                    let k1 = mul32 (xor32 k0 (prelude.wrapping (prelude.quot k0
                        16777216))) (murmurM unitValue) in
                      murmurChunks rest4 (xor32 (mul32 h (murmurM unitValue))
                        k1) end let end let
              end case
          end case
      end case
  end case
end function

function toPositive (h :: UInt32) -> UInt32 is prelude.wrapping (prelude.rem h
    2147483648) end function

function mul32 (a :: UInt32) (b :: UInt32) -> UInt32 is prelude.wrapping (a * b)
end function

function xor32 (a :: UInt32) (b :: UInt32) -> UInt32 is prelude.wrapping
    (xorBits a b 2147483648) end function

-- a xor b, from bit down to the lowest, for a and b below twice bit.
function xorBits (a :: Integer) (b :: Integer) (bit :: Integer) -> Integer is
  if bit <= 0 || a < 0 || b < 0 then 0 else
    (if prelude.quot a bit != prelude.quot b bit then bit else 0 end if)
      + xorBits (prelude.rem a bit) (prelude.rem b bit) (prelude.quot bit 2)
  end if
end function

-- Kafka's own vectors for murmur2 (UtilsTest), as unsigned 32-bit values.
law "|murmur2 agrees with Kafka| is
  definition :
    murmur2 (prelude.utf8 "21") = 3321034988
    and murmur2 (prelude.utf8 "foobar") = 3504634814
    and murmur2 (prelude.utf8 "a-little-bit-long-string") = 3308985760
    and murmur2 (prelude.utf8 "a-little-bit-longer-string") = 2808662467
    and murmur2 (prelude.utf8
      "lkjh234lh9fiuh90y23oiuhsafujhadof229phr9h19h89h8") = 4236069325
    and murmur2 (prelude.utf8 "abc") = 479470107
  end definition
  references : "KAFKA-murmur2" end references
end law

-- ---------------------------------------------------------------------------
-- Producer
-- ---------------------------------------------------------------------------

ability Producer with Cluster is
  send :: ProducerRecord -> Either KafkaError RecordMetadata
  flush :: Unit
  enableIdempotence :: Either KafkaError ProducerIdAndEpoch
  retryLastSend :: Either KafkaError RecordMetadata
  producerIdentity :: Maybe ProducerIdAndEpoch
  laws
    law "|records sent to one partition are read in the order sent| is
      definition :
        for all (t :: Text where model.validTopicName t) (first :: Record)
          (second :: Record) =>
          created t 1 implies
          (let a = send (ProducerRecord record{ destination = t , choice =
              (ToPartition 0) , payload = first}) in
            let b = send (ProducerRecord record{ destination = t , choice =
                (ToPartition 0) , payload = second}) in
              readInOrder a b first second end let end let) = true end for all
      end definition
      description :
        "Within one partition, records are stored and read in the order they
      were sent: the later send gets the next offset, and a consumer reading
      from the first gets both, first to last."
      end description
    end law

    law "|a flushed record is in the log| is
      definition :
        for all (t :: Text where model.validTopicName t) (r :: Record) =>
          created t 1 implies
          (first matching case of send (ProducerRecord record{ destination = t ,
            choice = (ToPartition 0) , payload = r}) :
            when Left e then false
            when Right md then
              flush;
              (first matching case of prelude.attempt (listOffsetsRequest
                (TopicPartition record{ topic = t , partition = 0}) Latest
                ReadUncommitted) :
                when Left e then false
                when Right latest then latest > md.sentAt
              end case)
          end case) = true end for all
      end definition
    end law

    law "|an idempotent producer's retried send is written once| is
      definition :
        for all (t :: Text where model.validTopicName t) (r :: Record) =>
          created t 1 implies
          (let id = enableIdempotence in
            let sent = send (ProducerRecord record{ destination = t , choice =
                (ToPartition 0) , payload = r}) in
              let retried = retryLastSend in
                prelude.isRight id && sent = retried
                  && followsOne sent (prelude.attempt (listOffsetsRequest
                    (TopicPartition record{ topic = t , partition = 0}) Latest
                    ReadUncommitted))
                && producerIdentity = (first matching case of id : when Right pe
                  then Present pe when Left e then Absent end case) end let
            end let end let) = true end for all
      end definition
      references : "KIP-98" end references
    end law

    law "|records with one key go to one partition| is
      definition :
        for all (t :: Text where model.validTopicName t) (n :: Int32 where n >=
            1 && n <= 16)
          (key :: Bytes) (first :: Maybe Bytes) (second :: Maybe Bytes) =>
          created t n implies
          (let a = send (ProducerRecord record{ destination = t , choice = ByKey
            , payload = (Record record{ key = (Present key) , value = first ,
              headers = []})}) in
            let b = send (ProducerRecord record{ destination = t , choice =
                ByKey , payload = (Record record{ key = (Present key) , value =
                    second , headers = []})}) in
              samePartition a b end let end let) = true end for all
      end definition
    end law

    law "|a send to a partition the topic lacks is refused| is
      definition :
        for all (t :: Text where model.validTopicName t) (n :: Int32 where n >=
            1 && n <= 16) (r :: Record) =>
          created t n implies
          send (ProducerRecord record{ destination = t , choice = (ToPartition
            n) , payload = r}) = Left UnknownTopicOrPartition end for all
      end definition
    end law
  end laws
end ability

handler kafkaProducer for Producer with state producerState :: ProducerState
  start freshProducer unitValue is
  operation send by producerSend end operation
  operation flush by producerFlush end operation
  operation enableIdempotence by producerIdempotent end operation
  operation retryLastSend by producerRetry end operation
  operation producerIdentity by identityOf end operation
end handler

function samePartition (a :: Either KafkaError RecordMetadata) (b :: Either
  KafkaError RecordMetadata) -> Bool is
  first matching case of a :
    when Left e then false
    when Right x then
      first matching case of b :
        when Left e then false
        when Right y then x.sentTo = y.sentTo
      end case
  end case
end function

function followsOne (a :: Either KafkaError RecordMetadata) (latest :: Either
  KafkaError Int64) -> Bool is
  first matching case of a :
    when Left e then false
    when Right md then
      first matching case of latest :
        when Left e then false
        when Right l then l = md.sentAt + 1
      end case
  end case
end function

-- A consumer assigned the partition, from the first record's offset, reads
-- the two records next to each other, in the order they were sent.
procedure readInOrder (a :: Either KafkaError RecordMetadata) (b :: Either
  KafkaError RecordMetadata) (first :: Record) (second :: Record) -> Bool uses
  Consumer is
  first matching case of a :
    when Left e then false
    when Right x then
      first matching case of b :
        when Left e then false
        when Right y then
          let tp = x.sentTo in
            y.sentTo = tp && y.sentAt = x.sentAt + 1
              && (assign [tp];
                prelude.isRight (seek tp x.sentAt)
            && (first matching case of poll 2 :
              when Left e then false
              when Right rs then receivedRecords rs = [first, second] &&
                  receivedOffsets rs = [x.sentAt, y.sentAt]
            end case)) end let
      end case
  end case
end procedure

-- ---------------------------------------------------------------------------
-- Consumer
-- ---------------------------------------------------------------------------

ability Consumer with Cluster is
  assign :: List TopicPartition -> Unit
  subscribe :: Text -> Text -> List Text -> Either KafkaError (List
  TopicPartition)
  poll :: Int32 -> Either KafkaError (List ConsumerRecord)
  commitSync :: Either KafkaError Unit
  seek :: TopicPartition -> Int64 -> Either KafkaError Unit
  position :: TopicPartition -> Either KafkaError Int64
  committedOffset :: TopicPartition -> Maybe Int64
  setIsolationLevel :: IsolationLevel -> Unit
  close :: Unit
  laws
    law "|a restarted consumer resumes at its committed offset| is
      definition :
        for all (t :: Text where model.validTopicName t) (g :: Text where g !=
            "") (m :: Text where m != "")
          (batch :: List Record where smallBatch batch) (n :: Int32 where n >= 1
            && n <= 16) =>
          created t 1 implies
          (prelude.isRight (prelude.attempt (produceRequest (TopicPartition
            record{ topic = t , partition = 0}) Absent batch))
            && resumesAtCommitted t g m n) = true end for all
      end definition
      description :
        "A consumer polls, commits and closes. When it subscribes again, it
      starts from the committed offset: a record is delivered again only at
      or after it, never before, so none is lost."
      end description
    end law

    law "|a poll reads each partition in offset order| is
      definition :
        for all (t :: Text where model.validTopicName t) (batch :: List Record
          where smallBatch batch) =>
          created t 1 implies
          (let tp = TopicPartition record{ topic = t , partition = 0} in
            prelude.isRight (prelude.attempt (produceRequest tp Absent batch))
              && (assign [tp];
            first matching case of poll 10 :
              when Left e then false
              when Right rs then increasing (receivedOffsets rs)
            end case) end let) = true end for all
      end definition
    end law

    law "|seek sets the position| is
      definition :
        for all (t :: Text where model.validTopicName t) (offset :: Int64 where
          offset >= 0) =>
          created t 1 implies
          (let tp = TopicPartition record{ topic = t , partition = 0} in assign
            [tp]; seek tp offset; position tp end let) = Right offset
        end for all
      end definition
    end law

    law "|only an assigned partition has a position| is
      definition :
        for all (t :: Text where model.validTopicName t) (other :: Text where
          other != t) =>
          (assign [TopicPartition record{ topic = t , partition = 0}]; position
            (TopicPartition record{ topic = other , partition = 0})) = Left
              IllegalState end for all
      end definition
    end law

    law "|a read-committed consumer never sees aborted records| is
      definition :
        for all (t :: Text where model.validTopicName t) (txid :: Text where
          txid != "")
          (aborted :: Record) (plain :: Record) =>
          created t 1 implies
          (let tp = TopicPartition record{ topic = t , partition = 0} in
            let a = writeAborted tp txid aborted in
              let p = prelude.attempt (produceRequest tp Absent [plain]) in
                setIsolationLevel ReadCommitted;
                  assign [tp];
                first matching case of poll 100 :
                  when Left e then false
                  when Right rs then
                    (first matching case of a : when Present o then
                      !(prelude.sortedSetMember o (prelude.sortedSetOf
                        (receivedOffsets rs))) when Absent then false end case)
                    && (first matching case of p : when Right o then
                      prelude.sortedSetMember o (prelude.sortedSetOf
                        (receivedOffsets rs)) when Left e then false end case)
                end case end let end let end let) = true end for all
      end definition
      references : "KIP-98" end references
    end law
  end laws
end ability

handler kafkaConsumer for Consumer with state consumerState :: ConsumerState
  start freshConsumer unitValue is
  operation assign by consumerAssign end operation
  operation subscribe by consumerJoin end operation
  operation poll by consumerPoll end operation
  operation commitSync by consumerCommit end operation
  operation seek by consumerSeek end operation
  operation position by consumerPositionOf end operation
  operation committedOffset by consumerCommitted end operation
  operation setIsolationLevel by consumerIsolation end operation
  operation close by consumerClose end operation
end handler

function receivedOffsets (rs :: List ConsumerRecord) -> List Int64 is
  first matching case of rs :
    when Nil then []
    when Cons r rest then Cons r.receivedAt (receivedOffsets rest)
  end case
end function

function receivedRecords (rs :: List ConsumerRecord) -> List Record is
  first matching case of rs :
    when Nil then []
    when Cons r rest then Cons r.received (receivedRecords rest)
  end case
end function

function increasing (xs :: List Int64) -> Bool is
  first matching case of xs :
    when Nil then true
    when Cons h t then
      first matching case of t :
        when Nil then true
        when Cons h2 t2 then h < h2 && increasing t
      end case
  end case
end function

function allAtLeast (floor :: Int64) (xs :: List Int64) -> Bool is
  first matching case of xs :
    when Nil then true
    when Cons h t then h >= floor && allAtLeast floor t
  end case
end function

-- Subscribes, polls n records, commits and closes; then subscribes again
-- and checks where it starts.
procedure resumesAtCommitted (t :: Text) (g :: Text) (m :: Text) (n :: Int32) ->
  Bool uses Consumer is
  let tp = TopicPartition record{ topic = t , partition = 0} in
    let joined = subscribe g m [t] in
      let polled = poll n in
        let committed = commitSync in
          close;
          let rejoined = subscribe g m [t] in
            let resumed = position tp in
              let after = committedOffset tp in
                let again = poll 100 in
                  prelude.isRight joined && prelude.isRight polled &&
                    prelude.isRight committed && prelude.isRight rejoined
                  && (first matching case of after :
                    when Absent then false
                    when Present c then
                      resumed = Right c
                      && (first matching case of again : when Left e then false
                        when Right rs then allAtLeast c (receivedOffsets rs)
                      end case)
                  end case) end let end let end let end let end let end let
    end let end let
end procedure

-- Writes one record in a transaction that aborts, and gives its offset.
procedure writeAborted (tp :: TopicPartition) (txid :: Text) (r :: Record) ->
  Maybe Int64 uses Broker is
  first matching case of prelude.attempt (initProducerIdRequest (Present txid)) :
    when Left e then Absent
    when Right pe then
      let added = prelude.attempt (addPartitionsToTxnRequest txid pe.producerId
          pe.producerEpoch [tp]) in
        first matching case of prelude.attempt (produceRequest tp (Present (tagOf
          pe 0)) [r]) :
          when Left e then Absent
          when Right o then
            first matching case of prelude.attempt (endTxnRequest txid
              pe.producerId pe.producerEpoch false) :
              when Left e then Absent
              when Right u then Present o
            end case
        end case end let
  end case
end procedure

-- ---------------------------------------------------------------------------
-- Group coordinator
-- ---------------------------------------------------------------------------

ability GroupCoordinator with Cluster is
  joinGroup :: Text -> Text -> List Text -> Int32 fails with KafkaError
  syncGroup :: Text -> Text -> Int32 -> List TopicPartition fails with
  KafkaError
  heartbeat :: Text -> Text -> Int32 -> Unit fails with KafkaError
  leaveGroup :: Text -> Text -> Unit fails with KafkaError
  describeGroup :: Text -> GroupView
  commitOffsets :: Text -> Text -> Int32 -> List OffsetEntry -> Unit fails with
  KafkaError
  fetchOffset :: Text -> TopicPartition -> Maybe Int64
  laws
    law "|every partition has exactly one owner in a generation| is
      definition :
        for all (t :: Text where model.validTopicName t) (n :: Int32 where n >=
            1 && n <= 16)
          (g :: Text where g != "") (ids :: List Text where !(prelude.isEmpty
            (memberIds ids))) =>
          created t n implies
          (joinEach g (memberIds ids) [t] && coversOnce t n (describeGroup g)) =
            true end for all
      end definition
      references : "KIP-848" end references
    end law

    law "|a sync gives a member the partitions the group view shows| is
      definition :
        for all (t :: Text where model.validTopicName t) (n :: Int32 where n >=
            1 && n <= 16)
          (g :: Text where g != "") (m :: Text where m != "") =>
          created t n implies
          (first matching case of prelude.attempt (joinGroup g m [t]) :
            when Left e then false
            when Right gen then
              first matching case of prelude.attempt (syncGroup g m gen) :
                when Left e then false
                when Right tps then viewOf m (describeGroup g) = tps &&
                    (describeGroup g).generation = gen
              end case
          end case) = true end for all
      end definition
    end law

    law "|a commit from an older generation is refused| is
      definition :
        for all (t :: Text where model.validTopicName t) (g :: Text where g !=
            "")
          (one :: Text where one != "") (other :: Text where other != "" &&
            other != one) =>
          created t 1 implies
          (first matching case of prelude.attempt (joinGroup g one [t]) :
            when Left e then false
            when Right old then
              let new = prelude.attempt (joinGroup g other [t]) in
                (commitOffsets g one old [OffsetEntry record{ topicPartition =
                    (TopicPartition record{ topic = t , partition = 0}) , offset
                  =
                    0}] fails with IllegalGeneration)
                && (first matching case of new :
                  when Left e then false
                  when Right gen then prelude.isRight (prelude.attempt
                      (commitOffsets g other gen [OffsetEntry record{
                        topicPartition = (TopicPartition record{ topic = t ,
                          partition = 0}) , offset = 0}]))
                end case) end let
          end case) = true end for all
      end definition
    end law

    law "|a heartbeat from an older generation asks the member to rejoin| is
      definition :
        for all (t :: Text where model.validTopicName t) (g :: Text where g !=
            "")
          (one :: Text where one != "") (other :: Text where other != "" &&
            other != one) =>
          created t 1 implies
          (first matching case of prelude.attempt (joinGroup g one [t]) :
            when Left e then false
            when Right old then
              let new = prelude.attempt (joinGroup g other [t]) in
                (heartbeat g one old fails with IllegalGeneration)
                && (first matching case of prelude.attempt (joinGroup g one [t])
                  :
                  when Left e then false
                  when Right rejoined then new = Right rejoined &&
                      prelude.isRight (prelude.attempt (heartbeat g one
                        rejoined))
                end case) end let
          end case) = true end for all
      end definition
      description :
        "A rebalance moves the group to a new generation. A member at the old
      one is told so on its next heartbeat; when it rejoins with the same
      subscription it learns the new generation without starting another."
      end description
    end law

    law "|leaving starts a new generation| is
      definition :
        for all (t :: Text where model.validTopicName t) (g :: Text where g !=
            "") (m :: Text where m != "") =>
          created t 1 implies
          (first matching case of prelude.attempt (joinGroup g m [t]) :
            when Left e then false
            when Right gen then prelude.isRight (prelude.attempt (leaveGroup g
                m)) && (describeGroup g).generation > gen
                && (heartbeat g m gen fails with UnknownMemberId)
          end case) = true end for all
      end definition
    end law

    law "|a committed offset can be fetched| is
      definition :
        for all (t :: Text where model.validTopicName t) (g :: Text where g !=
            "") (m :: Text where m != "")
          (offset :: Int64 where offset >= 0) =>
          created t 1 implies
          (first matching case of prelude.attempt (joinGroup g m [t]) :
            when Left e then false
            when Right gen then
              prelude.isRight (prelude.attempt (commitOffsets g m gen
                [OffsetEntry record{ topicPartition = (TopicPartition record{
                    topic = t , partition = 0}) , offset = offset}]))
                && fetchOffset g (TopicPartition record{ topic = t , partition =
                    0}) = Present offset
          end case) = true end for all
      end definition
    end law
  end laws
end ability

procedure joinEach (g :: Text) (ms :: List Text) (topics :: List Text) -> Bool
  uses GroupCoordinator is
  first matching case of ms :
    when Nil then true
    when Cons m rest then prelude.isRight (prelude.attempt (joinGroup g m
        topics)) && joinEach g rest topics
  end case
end procedure

function viewOf (m :: Text) (view :: GroupView) -> List TopicPartition is
  assignmentIn m view.members end function

function assignmentIn (m :: Text) (ms :: List MemberAssignment) -> List
  TopicPartition is
  first matching case of ms :
    when Nil then []
    when Cons a rest then if a.memberId = m then a.assigned else assignmentIn m
        rest end if
  end case
end function

-- ---------------------------------------------------------------------------
-- Transactions
-- ---------------------------------------------------------------------------

ability Transactions with Cluster is
  initTransactions :: Text -> Either KafkaError ProducerIdAndEpoch
  beginTransaction :: Either KafkaError Unit
  addPartitionsToTransaction :: List TopicPartition -> Either KafkaError Unit
  sendInTransaction :: ProducerRecord -> Either KafkaError RecordMetadata
  sendOffsetsToTransaction :: Text -> List OffsetEntry -> Either KafkaError Unit
  commitTransaction :: Either KafkaError Unit
  abortTransaction :: Either KafkaError Unit
  laws
    law "|a newer instance fences a zombie| is
      definition :
        for all (t :: Text where model.validTopicName t) (txid :: Text where
          txid != "") (r :: Record) =>
          created t 1 implies
          (prelude.isRight (initTransactions txid)
            && beginTransaction = Right unitValue
            && prelude.isRight (prelude.attempt (initProducerIdRequest (Present
              txid)))
            && sendInTransaction (ProducerRecord record{ destination = t ,
              choice = (ToPartition 0) , payload = r}) = Left ProducerFenced) =
            true end for all
      end definition
      description :
        "Another instance initialises the same transactional id. The first
      instance is now a zombie: its next transactional request is fenced."
      end description
      references : "KIP-98" end references
    end law

    law "|aborted records are never read committed| is
      definition :
        for all (t :: Text where model.validTopicName t) (txid :: Text where
          txid != "") (r :: Record) =>
          created t 1 implies
          (let tp = TopicPartition record{ topic = t , partition = 0} in
            prelude.isRight (initTransactions txid)
              && beginTransaction = Right unitValue
            && (first matching case of sendInTransaction (ProducerRecord record{
              destination = t , choice = (ToPartition 0) , payload = r}) :
              when Left e then false
              when Right md then abortTransaction = Right unitValue &&
                  committedFrom tp md.sentAt = []
            end case) end let) = true end for all
      end definition
      references : "KIP-98" end references
    end law

    law "|committed records are read committed together and in order| is
      definition :
        for all (t :: Text where model.validTopicName t) (txid :: Text where
          txid != "") (first :: Record) (second :: Record) =>
          created t 1 implies
          (let tp = TopicPartition record{ topic = t , partition = 0} in
            prelude.isRight (initTransactions txid)
              && beginTransaction = Right unitValue
            && (first matching case of sendInTransaction (ProducerRecord record{
              destination = t , choice = (ToPartition 0) , payload = first}) :
              when Left e then false
              when Right md then
                prelude.isRight (sendInTransaction (ProducerRecord record{
                  destination = t , choice = (ToPartition 0) , payload =
                    second}))
                  && committedFrom tp md.sentAt = []
                  && commitTransaction = Right unitValue
                  && committedFrom tp md.sentAt = [first, second]
            end case) end let) = true end for all
      end definition
      references : "KIP-98" end references
    end law

    law "|offsets sent in an aborted transaction are not committed| is
      definition :
        for all (t :: Text where model.validTopicName t) (txid :: Text where
          txid != "") (g :: Text where g != "")
          (offset :: Int64 where offset >= 0) =>
          created t 1 implies
          (let tp = TopicPartition record{ topic = t , partition = 0} in
            let before = offsetFetchRequest g tp in
              prelude.isRight (initTransactions txid)
                && beginTransaction = Right unitValue
                && sendOffsetsToTransaction g [OffsetEntry record{
                  topicPartition = tp , offset = offset}] = Right unitValue
                && abortTransaction = Right unitValue
                && offsetFetchRequest g tp = before end let end let) = true
        end for all
      end definition
      references : "KIP-98" end references
    end law

    law "|a transaction must begin before it ends| is
      definition :
        for all (txid :: Text where txid != "") =>
          (let id = initTransactions txid in commitTransaction end let) = Left
            IllegalState end for all
      end definition
    end law
  end laws
end ability

handler kafkaTransactions for Transactions with state txnState ::
  TransactionState start freshTransactions unitValue is
  operation initTransactions by transactionsInit end operation
  operation beginTransaction by transactionsBegin end operation
  operation addPartitionsToTransaction by transactionsAdd end operation
  operation sendInTransaction by transactionsSend end operation
  operation sendOffsetsToTransaction by transactionsOffsets end operation
  operation commitTransaction by transactionsCommit end operation
  operation abortTransaction by transactionsAbort end operation
end handler

end unit
