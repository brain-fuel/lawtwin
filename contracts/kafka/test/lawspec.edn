{
  :manifest-version 1
  :component {
    :name "test"
    :version "0.1.0"
  }
  :sources ["laws"]
  :dependencies {
    "lawtwin.kafka" "0.1.0"
  }
  :packages [".."]
  :targets [
    {
      :language :rust
      :root "rust"
      :native-bindings {
        :rust-crate "lawspec_example"
      }
    }
    {
      :language :python
      :root "python"
      :python ".venv/bin/python"
    }
    {
      :language :go
      :root "go"
    }
    {
      :language :java
      :root "java"
    }
    {
      :language :kotlin
      :root "kotlin"
    }
    {
      :language :fsharp
      :root "fsharp"
    }
    {
      :language :csharp
      :root "csharp"
    }
  ]
  :language-profile "1.0-rc.2"
  :verification {
    :layers [
      :proof
      :exhaustive
      :property
      :examples
      :runtime
      :model
    ]
  }
}
